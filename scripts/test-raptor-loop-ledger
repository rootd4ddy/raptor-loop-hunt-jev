#!/usr/bin/env python3
"""Self-contained test for raptor-loop-ledger. No network, no RAPTOR imports.
Drives the real CLI via subprocess in a temp dir and asserts the state-machine invariants.
Run: python3 scripts/test-raptor-loop-ledger   (exit 0 = all pass)"""
import json, os, subprocess, sys, tempfile, shutil

HERE = os.path.dirname(os.path.abspath(__file__))
LEDGER = os.path.join(HERE, "raptor-loop-ledger")
ENV = {**os.environ, "RAPTOR_LEDGER_FAKE_NOW": "1752600000"}

passed = failed = 0
def check(name, cond, extra=""):
    global passed, failed
    if cond:
        passed += 1; print(f"  ok   {name}")
    else:
        failed += 1; print(f"  FAIL {name}  {extra}")

def run(*args, stdin=None):
    p = subprocess.run([sys.executable, LEDGER, *args], capture_output=True, text=True,
                       input=stdin, env=ENV)
    out = {}
    try: out = json.loads(p.stdout) if p.stdout.strip() else {}
    except Exception: pass
    return p.returncode, out, p.stdout + p.stderr


# ---- shared fixture builders -------------------------------------------------
# A review job now needs vendor + evidence_hash + an explicit dispatched_by: a verdict with no
# bound evidence and no named vendor substantiates nothing, and dispatched_by used to DEFAULT to
# the literal "orchestrator" (the field meant to evidence dispatch asserted it by itself).
def job(target, verdict, model="gpt-5.6-sol", vendor="openai", dispatched_by="orchestrator"):
    return json.dumps({"model": model, "vendor": vendor, "target": target, "verdict": verdict,
                       "evidence_hash": f"sha256:{target}:{verdict}",
                       "dispatched_by": dispatched_by})


ALL_VECTORS = ["path", "query", "body", "cookie", "header", "enc-request",
               "cli", "env", "config", "other"]


def vmatrix(tested=("body",), observed="param bound, no structure change", omit=()):
    """A COMPLETE vector matrix — every delivery vector explicit, because a silently absent vector
    is an untested vector sold as a complete kill. `omit` deliberately drops vectors so a test can
    assert the incompleteness refusal."""
    rows = []
    for v in ALL_VECTORS:
        if v in omit:
            continue
        if v in tested:
            rows.append({"vector": v, "status": "tested",
                         "command_or_fixture": f"fixture:{v}", "observed": observed})
        else:
            rows.append({"vector": v, "status": "not-applicable",
                         "rationale": f"{v} does not reach this sink on this route"})
    return rows


def handoff(scope="exact-target", equivalence=None, author_assistance=False,
            marker_passed=True, control_passed=True):
    equivalence = equivalence or scope
    return json.dumps({
        "reviewer": "fresh-reviewer-1",
        "reviewer_independent": True,
        "package_digest": "sha256:poc-package",
        "environment_digest": "sha256:clean-environment",
        "instructions_artifact": "README.md#sha256:instructions",
        "author_assistance": author_assistance,
        "claim_scope": scope,
        "target_equivalence": equivalence,
        "success_marker": {"expected": "marker file contains RAPTOR_OK",
                           "observed": "marker file contains RAPTOR_OK" if marker_passed else "marker absent",
                           "passed": marker_passed},
        "negative_control": {"expected": "patched/control build does not create marker",
                             "observed": "marker absent" if control_passed else "marker present",
                             "passed": control_passed},
        "observed_artifacts": ["handoff/run.log#sha256:abc"],
    })

def main():
    tmp = os.path.realpath(tempfile.mkdtemp(prefix="ledger-test-"))  # macOS /var,/tmp are symlinks
    target = os.path.join(tmp, "target"); os.makedirs(target)
    # a real source file so evidence spans / paths resolve
    with open(os.path.join(target, "parser.c"), "w") as f:
        f.write("int f(int n){char b[8];for(int i=0;i<n;i++)b[i]=0;return b[0];}\n")
    # a real git worktree so receipts are commit-bound and the staleness axis can actually run —
    # conformance no longer fails OPEN when it cannot resolve a commit.
    _g = ["git", "-c", "user.email=t@t", "-c", "user.name=t", "-C", target]
    for cmd in (["init", "-q"], ["add", "-A"], ["commit", "-qm", "fixture"]):
        subprocess.run(_g + cmd, capture_output=True, text=True)
    ledger = os.path.join(tmp, "out", "ledger")
    L = ["--ledger", ledger]
    try:
        rc, out, _ = run("init", *L, "--target", target)
        check("init returns 0", rc == 0)
        check("init stamps target_identity", bool(out.get("target_identity", {}).get("target_path_id")))

        # --- add + idempotency ---
        sqli = json.dumps({"finding_sig": "sig-sqli-1", "component": "modules/report",
            "path": "modules/report/filter.py", "entry_point": "GET /report?q",
            "sink": "db.execute", "violated_invariant": "unsanitized q reaches SQL",
            "bug_class": "cwe-89"})
        rc, out, _ = run("add", *L, "--target", target, "--record", sqli)
        cid = out.get("candidate_id")
        check("add returns candidate id", bool(cid) and out.get("new") is True)
        rc, out2, _ = run("add", *L, "--target", target, "--record", sqli)
        check("add is idempotent (same id, new=false)", out2.get("candidate_id") == cid and out2.get("new") is False)

        # --- rejection with INCOMPLETE receipt is REFUSED, candidate stays open ---
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", cid,
                         "--to", "rejected", "--receipt", json.dumps({"rejection_reason": "non-exploitable"}))
        check("incomplete rejection REFUSED (exit 3)", rc == 3 and out.get("transition") == "REFUSED")
        check("refused rejection keeps candidate open", out.get("current_state") == "open")
        rc, out, _ = run("summary", *L)
        pend = [a["required_action"] for a in out.get("open_pending_actions", [])]
        check("refused rejection enqueues complete_rejection_bundle", "complete_rejection_bundle" in pend)

        # --- rejection citing a NONEXISTENT job is REFUSED ---
        full_reject = {"rejection_reason": "non-exploitable", "counter_hypothesis": "input is bound as a parameter",
            "vector_matrix": vmatrix(tested=("query", "body")),
            "independent_review": {"job_id": "J-doesnotexist"}}
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", cid,
                         "--to", "rejected", "--receipt", json.dumps(full_reject))
        check("rejection citing unknown job REFUSED", rc == 3 and any("not a recorded" in e for e in out.get("errors", [])))

        # --- record an OVERTURN job; rejection citing it is still REFUSED ---
        rc, jout, _ = run("cross-vendor", *L, "--job", job(cid, "overturn"))
        jid_over = jout.get("job_id"); check("cross-vendor overturn recorded", bool(jid_over))
        fr2 = {**full_reject, "independent_review": {"job_id": jid_over}}
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", cid,
                         "--to", "rejected", "--receipt", json.dumps(fr2))
        check("rejection on OVERTURN verdict REFUSED", rc == 3 and any("not 'uphold'" in e for e in out.get("errors", [])))

        # --- record an UPHOLD job; full bundle now ACCEPTED ---
        rc, jout, _ = run("cross-vendor", *L, "--job", job(cid, "uphold"))
        jid_up = jout.get("job_id")
        fr3 = {**full_reject, "independent_review": {"job_id": jid_up}}
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", cid,
                         "--to", "rejected", "--receipt", json.dumps(fr3))
        check("full rejection bundle ACCEPTED", rc == 0 and out.get("to") == "rejected", out)

        # --- unreachable rejection WITHOUT gating is REFUSED ---
        rc, out, _ = run("add", *L, "--target", target, "--record", json.dumps({
            "finding_sig": "sig-x", "component": "c", "path": "parser.c", "bug_class": "cwe-79"}))
        cx = out["candidate_id"]
        rc, jj, _ = run("cross-vendor", *L, "--job", job(cx, "uphold", model="m"))
        unreach = {"rejection_reason": "unreachable", "counter_hypothesis": "route not registered",
            "vector_matrix": vmatrix(tested=("path",), observed="404"),
            "independent_review": {"job_id": jj["job_id"]}}
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", cx, "--to", "rejected",
                         "--receipt", json.dumps(unreach))
        check("unreachable kill without gating REFUSED", rc == 3 and any("gating" in e for e in out.get("errors", [])))

        # --- confirmation: memory-safety, sanitizer oracle -> ACCEPTED + auto dirty_sweep ---
        rc, out, _ = run("add", *L, "--target", target, "--record", json.dumps({
            "finding_sig": "sig-oob", "component": "core", "path": "parser.c",
            "sink": "b[i]", "violated_invariant": "no bound on i", "bug_class": "memory-safety"}))
        coob = out["candidate_id"]
        # crash-inflation guard: dos oracle on a memory-safety exploitability claim -> REFUSED
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", coob, "--to", "confirmed",
                         "--receipt", json.dumps({"oracle_class": "dos", "replay_command": "r",
                            "input_hash": "ih", "expected_predicate": "process abort", "observed_artifacts": ["a"]}))
        check("dos oracle on memory-safety exploitability REFUSED (inflation guard)",
              rc == 3 and any("sanitizer-class" in e for e in out.get("errors", [])))
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", coob, "--to", "confirmed",
                         "--receipt", json.dumps({"oracle_class": "sanitizer", "replay_command": "asan-repro.sh",
                            "input_hash": "sha:deadbeef", "expected_predicate": "AddressSanitizer: stack-buffer-overflow in f",
                            "observed_artifacts": ["asan.log#sha1"]}))
        check("sanitizer confirmation ACCEPTED", rc == 0 and out.get("to") == "confirmed", out)
        check("confirmation auto-enqueues dirty_sweep", out.get("pending_enqueued"))

        # --- file-close REFUSED while sweep open ---
        rc, out, _ = run("file-close", *L, "--file", "parser.c")
        check("file-close REFUSED while sweep open", rc == 3 and out.get("file_close") == "REFUSED")

        # --- pending-complete the sweep, then file-close OK ---
        sweep_action = None
        _, s, _ = run("summary", *L)
        for a in s["open_pending_actions"]:
            if a["required_action"] == "dirty_sweep": sweep_action = a["action_id"]
        rc, out, _ = run("pending-complete", *L, "--action", sweep_action, "--receipt", json.dumps({
            "enumeration_recipe": {"callgraph_root": "f", "commands": ["cscope -L3 f"]},
            "discovered_sites": [{"site": "parser.c:1", "disposition": "ruled_out"}],
            "site_set_hash": "sha:sites1"}))
        check("dirty_sweep pending-complete OK", rc == 0 and out.get("pending_complete") == "OK")
        rc, out, _ = run("file-close", *L, "--file", "parser.c")
        check("file-close OK after sweep complete", rc == 0 and out.get("file_close") == "OK")

        # --- dirty_sweep completion with a bad receipt (grep-only, no hash) is REFUSED ---
        rc, out, _ = run("add", *L, "--target", target, "--record", json.dumps({
            "finding_sig": "sig-oob2", "component": "core", "path": "other.c", "bug_class": "cwe-787"}))
        c2 = out["candidate_id"]
        run("transition", *L, "--target", target, "--candidate", c2, "--to", "confirmed", "--receipt",
            json.dumps({"oracle_class": "sanitizer", "replay_command": "r", "input_hash": "h",
                        "expected_predicate": "asan", "observed_artifacts": ["x"]}))
        _, s2, _ = run("summary", *L)
        a2 = next(a["action_id"] for a in s2["open_pending_actions"] if a["required_action"] == "dirty_sweep")
        rc, out, _ = run("pending-complete", *L, "--action", a2, "--receipt", json.dumps({"site_set_hash": ""}))
        check("bad dirty_sweep receipt REFUSED", rc == 3 and out.get("pending_complete") == "REFUSED")

        # --- needs-live-validation is first-class, enqueues live_validation, blocks report ---
        rc, out, _ = run("add", *L, "--target", target, "--record", json.dumps({
            "finding_sig": "sig-idor", "component": "api", "path": "parser.c", "bug_class": "idor"}))
        cidor = out["candidate_id"]
        rc, out, _ = run("transition", *L, "--target", target, "--candidate", cidor, "--to",
                         "needs-live-validation", "--receipt", json.dumps({
                            "safe_test": "curl -H 'id: victim' /api/obj/2 as attacker; 200 = vuln, 403 = safe",
                            "potential_severity": "High"}))
        check("needs-live-validation ACCEPTED", rc == 0 and out.get("to") == "needs-live-validation")
        check("needs-live enqueues live_validation", out.get("pending_enqueued"))
        _, s3, _ = run("summary", *L)
        check("summary flags report_blocking while pendings open", s3.get("report_blocking") is True)
        check("summary renders one-line refs", any("[" in c["one_line"] for c in s3["candidates"]))

        # ============ Phase 3: conformance gate (deterministic closure) ============
        # (7) coverage-honesty: an inventory component with no coverage record -> FAIL
        inv = os.path.join(tmp, "inv.txt"); open(inv, "w").write("modules/report\nmodules/auth\nmodules/api\n")
        cov = os.path.join(tmp, "cov.txt"); open(cov, "w").write("modules/report\n")  # auth+api uncovered
        rc, out, _ = run("conformance", *L, "--inventory", inv, "--covered", cov)
        check("conformance FAILS on uncovered components (coverage-honesty)",
              rc == 3 and set(out["failures"].get("uncovered_components_implied_done", [])) == {"modules/auth", "modules/api"})
        # cover the rest -> that specific check clears (pendings still block, tested below)
        open(cov, "w").write("modules/report\nmodules/auth\n")
        omit = os.path.join(tmp, "omit.txt"); open(omit, "w").write("modules/api\n")
        rc, out, _ = run("conformance", *L, "--inventory", inv, "--covered", cov, "--omitted", omit)
        check("conformance: covered+omitted clears the coverage check",
              "uncovered_components_implied_done" not in out["failures"])

        # (open pendings still block the report at this point)
        check("conformance FAILS while pendings open", out["conformance"] == "FAIL"
              and out["failures"].get("open_pending_actions_block_report"))

        # (3+4) claims-reconciliation: claim a REJECTED candidate as confirmed -> FAIL
        claims = os.path.join(tmp, "claims.json")
        open(claims, "w").write(json.dumps({"confirmed": [cid]}))   # cid was REJECTED earlier
        rc, out, _ = run("conformance", *L, "--claims", claims)
        check("conformance FAILS when a claim contradicts the ledger",
              any("state='rejected'" in x for x in out["failures"].get("report_claims_contradict_ledger", [])))
        # a claim referencing a nonexistent candidate -> FAIL
        open(claims, "w").write(json.dumps({"confirmed": ["C-ghost"]}))
        rc, out, _ = run("conformance", *L, "--claims", claims)
        check("conformance FAILS on a claim with no such candidate",
              any("no such candidate" in x for x in out["failures"].get("report_claims_contradict_ledger", [])))

        # (9) staleness + target binding. Pointing --target at a DIFFERENT commit-bearing tree must
        # not let that tree's HEAD stand in for the reviewed one: the gate refuses to certify one
        # tree against another, and every receipt bound to the real target reads as stale there.
        skillrepo = HERE + "/.."
        rc, out, _ = run("conformance", *L, "--target", skillrepo)
        check("conformance REFUSES a --target that is not the initialised target",
              "target_mismatch" in out["failures"], out.get("failures", {}).keys())
        check("receipts certified elsewhere read as stale against a foreign HEAD",
              "stale_receipts_vs_current_commit" in out["failures"])
        # against the REAL target the same receipts are fresh — no false positive.
        rc, out, _ = run("conformance", *L, "--target", target)
        check("no staleness false-positive against the correct target",
              "stale_receipts_vs_current_commit" not in out["failures"] and
              "target_mismatch" not in out["failures"], out.get("failures"))

        # --- a live_validation no longer closes on nothing (the widest fail-open in the old gate) ---
        _, sfin, _ = run("summary", *L)
        lv = next(a for a in sfin["open_pending_actions"] if a["required_action"] == "live_validation")
        rc, out, _ = run("pending-complete", *L, "--action", lv["action_id"])
        check("live_validation with EMPTY receipt REFUSED", rc == 3 and out.get("pending_complete") == "REFUSED")
        rc, out, _ = run("pending-complete", *L, "--action", lv["action_id"], "--receipt", json.dumps({
            "outcome": "inconclusive", "observation": "no instance reachable", "artifacts": ["log"],
            "build_digest": "sha256:deadbeef"}))
        check("live_validation inconclusive without blocker REFUSED", rc == 3)
        rc, out, _ = run("pending-complete", *L, "--action", lv["action_id"], "--receipt", json.dumps({
            "outcome": "safe", "observation": "server rebinds the id to the session; 403 returned",
            "artifacts": ["live/lv1.log"], "build_digest": "sha256:deadbeef"}))
        check("live_validation with a real observation ACCEPTED", rc == 0)
        rc, out, _ = run("pending-complete", *L, "--action", lv["action_id"], "--receipt", json.dumps({
            "outcome": "vulnerable", "observation": "rewrite attempt", "artifacts": ["x"],
            "build_digest": "d"}))
        check("completed action cannot be re-completed (receipts immutable)", rc == 3)

        # closing the run now requires RESOLVING every candidate, not just closing actions.
        _, sfin, _ = run("summary", *L)
        for a in sfin["open_pending_actions"]:
            if a["required_action"] == "dirty_sweep":
                run("pending-complete", *L, "--action", a["action_id"], "--receipt", json.dumps({
                    "enumeration_recipe": {"commands": ["x"]}, "discovered_sites": [], "site_set_hash": "h"}))
        # cx: the unreachable kill, now WITH the gating evidence it was refused for
        gated = {**unreach, "gating": {"build_digest": "b1", "config_digest": "c1",
                                       "route_or_symbol_evidence": "no route registers this handler"}}
        run("transition", *L, "--target", target, "--candidate", cx, "--to", "rejected",
            "--receipt", json.dumps(gated))
        # the needs-live candidate: its live test came back safe, so it lands as rejected
        nl_job = run("cross-vendor", *L, "--job", job(cidor, "uphold", model="m"))[1]["job_id"]
        run("transition", *L, "--target", target, "--candidate", cidor, "--to", "rejected",
            "--receipt", json.dumps({"rejection_reason": "non-exploitable",
                "counter_hypothesis": "the server rebinds the id to the session (live-observed)",
                "vector_matrix": vmatrix(tested=("body",), observed="403"),
                "independent_review": {"job_id": nl_job}}))
        # a gate run missing mandatory inputs is PARTIAL, never PASS — and it says WHICH axes it
        # skipped instead of advertising a hardcoded list of all six.
        rc, out, _ = run("conformance", *L, "--inventory", inv, "--covered", cov, "--omitted", omit)
        check("skipped axes cap the verdict at PARTIAL (never a silent PASS)",
              rc == 3 and out["conformance"] == "PARTIAL", out.get("conformance"))
        skipped_checks = {s["check"] for s in out.get("checks_skipped", [])}
        check("checks_skipped names the axes that did not run", {"staleness", "claims"} <= skipped_checks,
              skipped_checks)
        check("checks_executed excludes the axes that did not run",
              "staleness" not in out.get("checks_executed", []) and
              "claims" not in out.get("checks_executed", []), out.get("checks_executed"))

        claims_f = os.path.join(tmp, "claims.json")
        _, sfin2, _ = run("summary", *L)
        with open(claims_f, "w") as f:
            json.dump({"confirmed": [c["candidate_id"] for c in sfin2["candidates"]
                                     if c.get("state") in ("confirmed", "corrected")],
                       "rejected": [c["candidate_id"] for c in sfin2["candidates"]
                                    if c.get("state") == "rejected"]}, f)
        rc, out, _ = run("conformance", *L, "--target", target, "--inventory", inv,
                         "--covered", cov, "--omitted", omit, "--claims", claims_f)
        check("conformance PASSES only when EVERY axis ran and every diff is empty",
              rc == 0 and out["conformance"] == "PASS", out.get("failures"))
        check("PASS reports checks_executed built from real branches (not a hardcoded list)",
              {"coverage", "candidate_closure", "staleness", "claims"} <= set(out.get("checks_executed", [])),
              out.get("checks_executed"))

        # ================= MATERIAL-DOWNGRADE GATE + F-22 regression (fresh ledger) =================
        L2 = ["--ledger", os.path.join(tmp, "out", "ledger2")]
        run("init", *L2, "--target", target)

        SS = {"invocation_mode": "stdin script", "interpreter_grammar": "psql \\! meta-command",
              "execution_identity": "container root"}
        def conf(eff, ss=False):  # a valid confirmation receipt carrying an effective severity
            r = {"oracle_class": "authorization", "replay_command": "curl ...", "input_hash": "h1",
                 "expected_predicate": "status==200 and body has X", "observed_artifacts": ["a1"],
                 "effective_severity": eff}
            if ss: r["sink_semantics"] = SS
            return r

        # severe finding reaching a named sink -> auto-enqueues a SINK-KEYED enumerate_trigger_paths
        restore = json.dumps({"finding_sig": "sig-restore-rce", "component": "server/maintenance",
            "path": "server/src/services/database-backup.service.ts", "entry_point": "POST /admin/database-backups/start-restore",
            "sink": "psql <- uploaded backup content", "violated_invariant": "backup CONTENT unvalidated",
            "bug_class": "cwe-78", "potential_severity": "critical"})
        rc, out, _ = run("add", *L2, "--target", target, "--record", restore)
        rcid = out["candidate_id"]
        _, s, _ = run("summary", *L2)
        pend = [a["required_action"] for a in s.get("open_pending_actions", [])]
        check("severe-sink hypothesis auto-enqueues enumerate_trigger_paths", "enumerate_trigger_paths" in pend)

        # CASE 1: High/Crit -> corrected Low WITHOUT a material_downgrade_receipt is REFUSED (the F-22 gap)
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", rcid,
                         "--to", "corrected", "--receipt", json.dumps(conf("low")))
        check("material downgrade (severe->Low) without receipt REFUSED", rc == 3 and out.get("transition") == "REFUSED")
        check("refused downgrade enqueues complete_material_downgrade_bundle",
              any("complete_material_downgrade_bundle" in a.get("required_action", "")
                  for a in run("summary", *L2)[1].get("open_pending_actions", [])))

        # CASE 2: High -> Medium is an ORDINARY correction, NOT material (needs no downgrade bundle)
        med = json.dumps({"finding_sig": "sig-hi-med", "component": "c", "path": "parser.c",
            "sink": "x", "bug_class": "authz", "potential_severity": "high"})
        mcid = run("add", *L2, "--target", target, "--record", med)[1]["candidate_id"]
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", mcid,
                         "--to", "corrected", "--receipt", json.dumps(conf("medium")))
        check("severe->Medium correction ACCEPTED (not material)", rc == 0 and out.get("transition") == "ACCEPTED")

        # CASE 3: Critical -> High correction is NOT material
        crH = json.dumps({"finding_sig": "sig-crit-high", "component": "c", "path": "parser.c",
            "sink": "x", "bug_class": "authz", "potential_severity": "critical"})
        chid = run("add", *L2, "--target", target, "--record", crH)[1]["candidate_id"]
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", chid,
                         "--to", "corrected", "--receipt", json.dumps(conf("high")))
        check("critical->High correction ACCEPTED (not material)", rc == 0 and out.get("transition") == "ACCEPTED")

        # CASE 4: downgrade citing an OVERTURN cross-vendor job is REFUSED (needs concur_downgrade)
        run("cross-vendor", *L2, "--job", job(rcid, "overturn"))
        ov_job = run("cross-vendor", *L2, "--job", job(rcid, "overturn"))[1]["job_id"]
        md_overturn = conf("low", ss=True); md_overturn["material_downgrade_receipt"] = {
            "negated_hypothesis": "restore is only a DoS", "consequence_trace": "psql streams content",
            "trigger_paths": [{"path_id": "start-restore", "status": "tested", "observed": "400 getAdmin"}],
            "gating": {"build": "b1"}, "independent_review": {"job_id": ov_job}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", rcid,
                         "--to", "corrected", "--receipt", json.dumps(md_overturn))
        check("downgrade citing OVERTURN job REFUSED (needs concur_downgrade)",
              rc == 3 and any("concur_downgrade" in e for e in out.get("errors", [])))

        # CASE 5: downgrade with an UNRESOLVED trigger path (needs-live) is REFUSED (not silently safe)
        cd_job = run("cross-vendor", *L2, "--job", job(rcid, "concur_downgrade"))[1]["job_id"]
        md_unresolved = conf("low", ss=True); md_unresolved["material_downgrade_receipt"] = {
            "negated_hypothesis": "n", "consequence_trace": "t",
            "trigger_paths": [{"path_id": "start-restore", "status": "tested", "observed": "400 getAdmin"},
                              {"path_id": "admin-maintenance", "status": "needs-live", "evidence": "not tested"}],
            "gating": {"build": "b1"}, "independent_review": {"job_id": cd_job}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", rcid,
                         "--to", "corrected", "--receipt", json.dumps(md_unresolved))
        check("downgrade with an unresolved trigger path REFUSED", rc == 3 and
              any("unresolved" in e for e in out.get("errors", [])))

        # CASE 6: COMPLETE downgrade bundle (both paths resolved + concur_downgrade job) is ACCEPTED
        md_ok = conf("low", ss=True); md_ok["material_downgrade_receipt"] = {
            "negated_hypothesis": "n", "consequence_trace": "psql content streamed; both paths gated",
            "trigger_paths": [{"path_id": "start-restore", "status": "tested", "observed": "400 getAdmin"},
                              {"path_id": "admin-maintenance", "status": "tested", "observed": "403 non-admin"}],
            "gating": {"build": "b1", "route": "r1"}, "independent_review": {"job_id": cd_job}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", rcid,
                         "--to", "corrected", "--receipt", json.dumps(md_ok))
        check("complete material-downgrade bundle ACCEPTED", rc == 0 and out.get("transition") == "ACCEPTED")

        # CASE 7: duplicate/out-of-scope of a severe finding WITHOUT a canonical link is a material downgrade
        oos = json.dumps({"finding_sig": "sig-oos", "component": "c", "path": "parser.c",
            "sink": "y", "bug_class": "authz", "potential_severity": "high"})
        ocid = run("add", *L2, "--target", target, "--record", oos)[1]["candidate_id"]
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", ocid,
                         "--to", "out-of-scope", "--receipt", json.dumps({"reason": "meh"}))
        check("severe out-of-scope without canonical link REFUSED (material)", rc == 3)
        # a FAKE canonical string is not a preservation (gpt-5.6-sol fix #1)
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", ocid,
                         "--to", "duplicate", "--receipt", json.dumps({"reason": "dup", "canonical_finding": "F-nope"}))
        check("severe duplicate citing a FAKE canonical REFUSED", rc == 3)
        # a REAL, still-severe canonical candidate preserves the finding -> ACCEPTED
        canon = json.dumps({"finding_sig": "sig-canon", "component": "c", "path": "parser.c",
            "sink": "y", "bug_class": "authz", "potential_severity": "high"})
        canid = run("add", *L2, "--target", target, "--record", canon)[1]["candidate_id"]
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", ocid,
                         "--to", "duplicate", "--receipt", json.dumps({"reason": "dup", "canonical_finding": canid}))
        check("severe duplicate WITH a real severe canonical ACCEPTED (preserved)", rc == 0)

        # CASE 7b: hardening — an UNHASHABLE path_id is refused, not crashed (gpt-5.6-sol new-issue)
        sev2 = json.dumps({"finding_sig": "sig-crash", "component": "c", "path": "parser.c",
            "sink": "z", "bug_class": "authz", "potential_severity": "critical"})
        s2 = run("add", *L2, "--target", target, "--record", sev2)[1]["candidate_id"]
        cd2 = run("cross-vendor", *L2, "--job", job(s2, "concur_downgrade", model="m"))[1]["job_id"]
        md_bad = conf("low"); md_bad["material_downgrade_receipt"] = {"negated_hypothesis": "n",
            "consequence_trace": "t", "gating": {"build": "b"}, "independent_review": {"job_id": cd2},
            "trigger_paths": [{"path_id": {"nope": 1}, "status": "tested", "observed": "x"}]}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", s2,
                         "--to", "corrected", "--receipt", json.dumps(md_bad))
        check("unhashable path_id REFUSED (no crash)", rc == 3 and
              any("non-empty string" in e for e in out.get("errors", [])))
        # CASE 7c: a downgrade citing a job bound to a DIFFERENT candidate is refused (no job reuse)
        md_reuse = conf("low"); md_reuse["material_downgrade_receipt"] = {"negated_hypothesis": "n",
            "consequence_trace": "t", "gating": {"build": "b"}, "independent_review": {"job_id": cd_job},  # cd_job targets rcid
            "trigger_paths": [{"path_id": "p1", "status": "tested", "observed": "x"}]}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", s2,
                         "--to", "corrected", "--receipt", json.dumps(md_reuse))
        check("downgrade reusing another candidate's review job REFUSED", rc == 3 and
              any("cannot be reused" in e for e in out.get("errors", [])))

        # CASE 7d: Critical->Medium is a >=2-level drop => MATERIAL now (gpt-5.6-sol amendment: F-22 was
        # capped Critical->Medium, which an effective-Low-only rule missed). No bundle -> REFUSED.
        cm = json.dumps({"finding_sig": "sig-crit-med", "component": "c", "path": "parser.c",
            "sink": "album membership write", "bug_class": "authz", "potential_severity": "critical"})
        cmid = run("add", *L2, "--target", target, "--record", cm)[1]["candidate_id"]
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", cmid,
                         "--to", "corrected", "--receipt", json.dumps(conf("medium")))
        check("Critical->Medium (2-level) is material -> REFUSED without bundle", rc == 3 and
              out.get("transition") == "REFUSED")

        # CASE 7e: interpreter/process sink confirmed >=2 levels below its hwm needs sink_semantics
        psqlf = json.dumps({"finding_sig": "sig-psql-conf", "component": "c", "path": "parser.c",
            "sink": "psql <- uploaded content", "bug_class": "cwe-78", "potential_severity": "critical"})
        pcid = run("add", *L2, "--target", target, "--record", psqlf)[1]["candidate_id"]
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", pcid,
                         "--to", "confirmed", "--receipt", json.dumps(conf("medium")))  # no sink_semantics
        check("interpreter-sink confirmed medium WITHOUT sink_semantics REFUSED", rc == 3 and
              any("sink_semantics" in e for e in out.get("errors", [])))
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", pcid,
                         "--to", "confirmed", "--receipt", json.dumps(conf("medium", ss=True)))
        check("interpreter-sink confirmed medium WITH sink_semantics ACCEPTED", rc == 0 and
              out.get("to") == "confirmed")

        # CASE 7f: placeholder/stub candidate is REFUSED at add (invalid-cell lint; the B3 failure)
        rc, out, err = run("add", *L2, "--target", target, "--record", json.dumps({
            "finding_sig": "test", "component": "a", "sink": "f", "entry_point": "1"}))
        check("placeholder candidate REFUSED at add", rc != 0 and "placeholder" in err.lower())

        # CASE 7g: an INVARIANT-based kill without the all-writers challenge is REFUSED
        iv = json.dumps({"finding_sig": "sig-inv", "component": "c", "path": "parser.c",
            "sink": "group write", "bug_class": "authz"})
        ivid = run("add", *L2, "--target", target, "--record", iv)[1]["candidate_id"]
        ivjob = run("cross-vendor", *L2, "--job", job(ivid, "uphold", model="m"))[1]["job_id"]
        inv_reject = {"rejection_reason": "non-exploitable",
            "counter_hypothesis": "duplicate groups are always single-owner so no cross-tenant write",
            "vector_matrix": vmatrix(tested=("body",), observed="scoped"),
            "independent_review": {"job_id": ivjob}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", ivid, "--to", "rejected",
                         "--receipt", json.dumps(inv_reject))
        check("invariant kill without all_writers challenge REFUSED (F-07 guard)", rc == 3 and
              any("all_writers" in e or "invariant_challenge" in e for e in out.get("errors", [])))

        # CASE 7h: an EXPECTED-BEHAVIOR kill without a policy artifact is REFUSED ("a sibling does it" != intent)
        eb = json.dumps({"finding_sig": "sig-eb", "component": "c", "path": "parser.c",
            "sink": "mapUser email", "bug_class": "info-leak"})
        ebid = run("add", *L2, "--target", target, "--record", eb)[1]["candidate_id"]
        ebjob = run("cross-vendor", *L2, "--job", job(ebid, "uphold", model="m"))[1]["job_id"]
        eb_reject = {"rejection_reason": "expected-behavior",
            "counter_hypothesis": "GET /users already returns email so this is intended baseline",
            "vector_matrix": vmatrix(tested=("path",), observed="email present"),
            "independent_review": {"job_id": ebjob}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", ebid, "--to", "rejected",
                         "--receipt", json.dumps(eb_reject))
        check("expected-behavior kill without policy_evidence REFUSED (F-18 guard)", rc == 3 and
              any("policy_evidence" in e for e in out.get("errors", [])))

        # CASE 7g2: a COMPLETE invariant challenge (substantive all_writers + mutation_paths + bool) ACCEPTED
        iv2 = json.dumps({"finding_sig": "sig-inv2", "component": "c", "path": "parser.c", "sink": "grp", "bug_class": "authz"})
        iv2id = run("add", *L2, "--target", target, "--record", iv2)[1]["candidate_id"]
        iv2job = run("cross-vendor", *L2, "--job", job(iv2id, "uphold", model="m"))[1]["job_id"]
        inv_ok = {"rejection_reason": "non-exploitable",
            "counter_hypothesis": "the group is always single-owner",
            "invariant_challenge": {"invariant": "at most one owner per group",
                "enforcement_site": "album-user.table.ts:20 unique index",
                "all_writers": ["album.service.ts:128 create", "album.service.ts:336 updateUser",
                                "asset.service.ts:130 updateAll duplicateId"],
                "mutation_paths": ["PUT /assets {duplicateId}", "POST /duplicates/resolve"],
                "counterexample_tested": True},
            "vector_matrix": vmatrix(tested=("body",), observed="index holds"),
            "independent_review": {"job_id": iv2job}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", iv2id, "--to", "rejected",
                         "--receipt", json.dumps(inv_ok))
        check("complete invariant-challenge rejection ACCEPTED", rc == 0 and out.get("to") == "rejected", out)

        # CASE 7h2: a COMPLETE expected-behavior kill (policy artifact + quote) ACCEPTED
        eb2 = json.dumps({"finding_sig": "sig-eb2", "component": "c", "path": "parser.c", "sink": "field", "bug_class": "info-leak"})
        eb2id = run("add", *L2, "--target", target, "--record", eb2)[1]["candidate_id"]
        eb2job = run("cross-vendor", *L2, "--job", job(eb2id, "uphold", model="m"))[1]["job_id"]
        eb_ok = {"rejection_reason": "expected-behavior", "counter_hypothesis": "documented public field",
            "policy_evidence": {"artifact": "docs/api/privacy.md", "span_or_url": "privacy.md:44",
                "quote": "the display name is a public profile field exposed to all authenticated users"},
            "vector_matrix": vmatrix(tested=("path",), observed="name present"),
            "independent_review": {"job_id": eb2job}}
        rc, out, _ = run("transition", *L2, "--target", target, "--candidate", eb2id, "--to", "rejected",
                         "--receipt", json.dumps(eb_ok))
        check("complete expected-behavior rejection ACCEPTED", rc == 0 and out.get("to") == "rejected", out)

        # CASE 8: conformance catches DIRECT-EDIT laundering (severe->corrected-Low, no material receipt)
        import json as _j
        led_path = os.path.join(tmp, "out", "ledger2", "ledger.json")
        with open(led_path) as f: raw = _j.load(f)
        raw["candidates"][mcid]["potential_hwm"] = "critical"     # pretend it was a severe finding
        raw["candidates"][mcid]["receipts"]["confirmation"]["receipt"]["effective_severity"] = "low"
        raw["candidates"][mcid].pop("material_downgrade", None)
        raw["candidates"][mcid]["receipts"].pop("material_downgrade", None)
        with open(led_path, "w") as f: _j.dump(raw, f)
        rc, out, _ = run("conformance", *L2)
        check("conformance FLAGS a severe finding downgraded to Low without a receipt (anti-laundering)",
              "severe_finding_downgraded_to_low_without_receipt" in out.get("failures", {}))

        # =============== HARDENING REGRESSIONS (2026-07-31) ================================
        # Each of these is a defect that was live in the shipped gate and is now closed.
        L3 = ["--ledger", os.path.join(tmp, "out", "ledger3")]
        run("init", *L3, "--target", target)
        mk = lambda sig: run("add", *L3, "--target", target, "--record", json.dumps(
            {"finding_sig": sig, "component": "c", "path": "parser.c", "bug_class": "authz"}))[1]["candidate_id"]

        # D1 — a kill that tests ONE vector and stays silent on the rest is not a refutation. In
        # observed runs rejections covered a small minority of the vector set, and `query` — the
        # vector that executed live in the canonical miss this rule exists for — appeared in none.
        a1 = mk("sig-h1")
        j1 = run("cross-vendor", *L3, "--job", job(a1, "uphold"))[1]["job_id"]
        partial = {"rejection_reason": "non-exploitable", "counter_hypothesis": "bound as a parameter",
                   "vector_matrix": vmatrix(tested=("path",), omit=("query", "cookie")),
                   "independent_review": {"job_id": j1}}
        rc, out, _ = run("transition", *L3, "--target", target, "--candidate", a1, "--to", "rejected",
                         "--receipt", json.dumps(partial))
        check("D1 rejection with an INCOMPLETE vector matrix REFUSED",
              rc == 3 and any("INCOMPLETE" in e and "query" in e for e in out.get("errors", [])))
        dupd = {**partial, "vector_matrix": vmatrix() + [{"vector": "body", "status": "tested",
                "command_or_fixture": "f", "observed": "o"}]}
        rc, out, _ = run("transition", *L3, "--target", target, "--candidate", a1, "--to", "rejected",
                         "--receipt", json.dumps(dupd))
        check("D1 duplicate vector rows REFUSED", rc == 3 and any("duplicate" in e for e in out.get("errors", [])))

        # D7 — a review job must name its vendor, bind to evidence, and state its dispatcher. These
        # were previously optional/defaulted: in observed runs every job carried an EMPTY
        # evidence_hash, and dispatched_by defaulted to the literal "orchestrator" it evidences.
        for miss in ("vendor", "evidence_hash", "dispatched_by"):
            rec = json.loads(job(a1, "uphold")); rec.pop(miss)
            rc, _o, err = run("cross-vendor", *L3, "--job", json.dumps(rec))
            check(f"D7 cross-vendor without {miss} REFUSED", rc != 0 and miss in err)

        # D7b — one uphold job cannot be recycled across findings; a review of a different candidate
        # is not a review of this one. (The downgrade path checked this; the rejection path did not.)
        a2 = mk("sig-h2")
        foreign = {"rejection_reason": "non-exploitable", "counter_hypothesis": "bound",
                   "vector_matrix": vmatrix(), "independent_review": {"job_id": j1}}
        rc, out, _ = run("transition", *L3, "--target", target, "--candidate", a2, "--to", "rejected",
                         "--receipt", json.dumps(foreign))
        check("D7b rejection citing a job that reviewed ANOTHER candidate REFUSED",
              rc == 3 and any("not this candidate" in e for e in out.get("errors", [])))

        # D4 — a candidate left open/needs-live must block closure; the promised candidate-ledger
        # diff was documented but never implemented, so unresolved work was invisible to the gate.
        rc, out, _ = run("conformance", *L3, "--target", target, "--inventory", inv)
        check("D4 non-terminal candidates block closure",
              "nonterminal_candidates_block_closure" in out.get("failures", {}))

        # D2 — the empirical walk that took a real ledger from FAIL to PASS with zero evidence:
        # close every live_validation with `{}`. Now default-denied.
        a3 = mk("sig-h3")
        run("transition", *L3, "--target", target, "--candidate", a3, "--to", "needs-live-validation",
            "--receipt", json.dumps({"safe_test": "curl x", "potential_severity": "High"}))
        _, s3, _ = run("summary", *L3)
        lv3 = next(a for a in s3["open_pending_actions"] if a["required_action"] == "live_validation")
        rc, out, _ = run("pending-complete", *L3, "--action", lv3["action_id"], "--receipt", "{}")
        check("D2 live_validation cannot be closed with an empty receipt", rc == 3)

        # D3 — direct-edit / legacy: a stored terminal receipt is RE-VALIDATED, not merely present.
        led3 = os.path.join(tmp, "out", "ledger3", "ledger.json")
        with open(led3) as f: raw3 = _j.load(f)
        raw3["candidates"][a2] = {**raw3["candidates"][a2], "state": "rejected", "receipts": {
            "rejection": {"receipt_id": "R-forged", "certified_commit": "",
                          "receipt": {"rejection_reason": "non-exploitable",
                                      "counter_hypothesis": "hand-edited past the transition gate",
                                      "vector_matrix": [{"vector": "path", "status": "tested",
                                                         "command_or_fixture": "f", "observed": "o"}]}}}}
        raw3["candidates"][a3]["state"] = "reviewed"      # a state the vocabulary does not contain
        with open(led3, "w") as f: _j.dump(raw3, f)
        rc, out, _ = run("conformance", *L3, "--target", target, "--inventory", inv)
        check("D3 a stored rejection receipt failing the CURRENT contract is caught",
              "stored_receipt_fails_current_contract" in out.get("failures", {}))
        check("D3 a candidate in an unknown state is caught",
              "candidate_in_unknown_state" in out.get("failures", {}))

        # D-tree-mixing — one engagement, one tree. Observed failure: a ledger initialised against one
        # path while the audit ran on another, so every receipt was written with an empty
        # certified_commit and nothing detected it. The guard fires at the WRITE, because by
        # closure time the evidence is already unbindable.
        other = os.path.join(tmp, "other-tree"); os.makedirs(other, exist_ok=True)
        rc, _o, err = run("add", *L3, "--target", other, "--record", json.dumps(
            {"finding_sig": "sig-wrong-tree", "component": "c", "path": "parser.c", "bug_class": "authz"}))
        check("D-tree-mixing add against a FOREIGN target REFUSED", rc != 0 and "initialised for" in err)
        rc, _o, err = run("transition", *L3, "--target", other, "--candidate", a1,
                          "--to", "rejected", "--receipt", json.dumps(partial))
        check("D-tree-mixing transition against a FOREIGN target REFUSED", rc != 0 and "initialised for" in err)

        # a git worktree whose HEAD will not resolve must not silently produce an unbound receipt
        led3b = os.path.join(tmp, "out", "ledger3", "ledger.json")
        with open(led3b) as f: rawb = _j.load(f)
        rawb["target_identity"]["commit_bindable"] = True
        with open(led3b, "w") as f: _j.dump(rawb, f)
        broken = os.path.join(tmp, "broken"); os.makedirs(broken, exist_ok=True)
        rawb["target_identity"]["target_path_id"] = __import__("hashlib").sha256(
            os.path.realpath(broken).encode()).hexdigest()[:16]
        with open(led3b, "w") as f: _j.dump(rawb, f)
        # use a receipt that PASSES validation, so execution reaches the commit-binding step
        rc, _o, err = run("transition", *L3, "--target", broken, "--candidate", a1,
                          "--to", "needs-live-validation", "--receipt", json.dumps(
                              {"safe_test": "curl /x; 200=vuln 403=safe", "potential_severity": "High"}))
        check("D-tree-mixing commit-bindable target with unresolvable HEAD REFUSED at write",
              rc != 0 and "empty certified_commit" in err, err[:160])

        # D-unused-ledger — an UNUSED ledger cannot certify a finished run. Observed real case: an
        # engagement whose ledger/ was left completely empty while the report read as complete;
        # every set-difference below is vacuously satisfied by absence.
        L4 = ["--ledger", os.path.join(tmp, "out", "ledger4")]
        rc, out, _ = run("conformance", *L4, "--target", target, "--inventory", inv)
        check("D-unused-ledger an EMPTY ledger cannot PASS (vacuous coverage is not coverage)",
              rc == 3 and "empty_ledger_no_hunt_recorded" in out.get("failures", {}),
              out.get("conformance"))
        check("D-unused-ledger an uninitialised ledger is flagged",
              "ledger_never_initialised" in out.get("failures", {}))

        # =============== FRESH-OPERATOR / INTERVENTION EXTENSION =========================
        # This axis is intentionally orthogonal to technical closure. `report_blocking` remains
        # about finding work; `delivery_blocking` is the owner-handoff quality gate.
        L5 = ["--ledger", os.path.join(tmp, "out", "ledger5")]
        run("init", *L5, "--target", target)
        _, s5, _ = run("summary", *L5)
        check("handoff: no review starts delivery blocked without blocking technical reporting",
              s5.get("delivery_readiness") == "blocked" and s5.get("delivery_blocking") is True
              and s5.get("report_blocking") is False)

        bad_intervention = {"stage": "setup", "unexpected_condition": "dependency missing",
                            "intervention": "installed it", "classification": "documentation-defect",
                            "evidence": ["setup.log"]}  # required booleans deliberately absent
        rc, out, _ = run("intervention", *L5, "--target", target,
                         "--record", json.dumps(bad_intervention))
        check("handoff: structurally incomplete intervention REFUSED",
              rc == 3 and out.get("intervention") == "REFUSED")

        docs_intervention = {"stage": "setup", "unexpected_condition": "required package absent",
            "intervention": "installed package manually", "classification": "documentation-defect",
            "documented_before_run": False, "required_for_success": True,
            "changed_target_semantics": False, "changed_security_controls": False,
            "operator_knowledge_required": True, "evidence": ["handoff/setup.log:12"]}
        rc, out, _ = run("intervention", *L5, "--target", target,
                         "--record", json.dumps(docs_intervention))
        iid_docs = out.get("intervention_id")
        check("handoff: required undocumented intervention recorded", rc == 0 and bool(iid_docs))

        rc, out, _ = run("handoff-review", *L5, "--target", target,
                         "--record", handoff())
        check("handoff: successful replay still needs documentation while tacit step is unresolved",
              rc == 0 and out.get("delivery_readiness") == "needs_documentation")
        rc, out, _ = run("conformance", *L5, "--target", target, "--require-handoff")
        check("handoff: owner-delivery conformance refuses unresolved workaround",
              rc == 3 and "delivery_readiness_not_ready" in out.get("failures", {}))

        rc, out, _ = run("intervention-resolve", *L5, "--target", target,
                         "--intervention", iid_docs, "--record", json.dumps({
                             "resolution": "documented", "evidence": ["README.md:18"],
                             "instructions_artifact": "README.md#sha256:new"}))
        check("handoff: documentation resolution accepted and requires a new cold replay",
              rc == 0 and out.get("delivery_readiness") == "blocked" and
              any("predates" in r for r in out.get("blocking_reasons", [])))
        rc, out, _ = run("intervention-resolve", *L5, "--target", target,
                         "--intervention", iid_docs, "--record", json.dumps({
                             "resolution": "documented", "evidence": ["README.md:18"],
                             "instructions_artifact": "README.md#sha256:new"}))
        check("handoff: duplicate resolution is refused without overwriting append-only history", rc == 3)

        rc, out, _ = run("intervention-resolve", *L5, "--target", target,
                         "--intervention", iid_docs, "--record", json.dumps({
                             "resolution": "eliminated", "evidence": ["handoff/setup-clean.log"],
                             "verification_artifact": "handoff/setup-clean.log#sha256:fixed"}))
        check("handoff: later resolution supersedes current state but preserves history",
              rc == 0 and out.get("delivery_readiness") == "blocked")

        rc, out, _ = run("handoff-review", *L5, "--target", target,
                         "--record", handoff())
        check("handoff: uncoached exact-target replay becomes delivery ready after documentation",
              rc == 0 and out.get("delivery_readiness") == "ready")
        rc, out, _ = run("conformance", *L5, "--target", target, "--require-handoff")
        check("handoff: ready receipt clears the delivery-specific conformance failure",
              "delivery_readiness_not_ready" not in out.get("failures", {}) and
              "fresh_operator_handoff" in out.get("checks_executed", []))

        semantic_intervention = {"stage": "exploit", "unexpected_condition": "mitigation blocked trigger",
            "intervention": "disabled the mitigation", "classification": "harness-defect",
            "documented_before_run": False, "required_for_success": True,
            "changed_target_semantics": True, "changed_security_controls": True,
            "operator_knowledge_required": True, "evidence": ["handoff/mitigation.log:4"]}
        rc, out, _ = run("intervention", *L5, "--target", target,
                         "--record", json.dumps(semantic_intervention))
        iid_sem = out.get("intervention_id")
        check("handoff: later semantics-changing intervention invalidates the earlier ready review",
              rc == 0 and out.get("delivery_readiness") == "blocked")
        run("intervention-resolve", *L5, "--target", target, "--intervention", iid_sem,
            "--record", json.dumps({"resolution": "documented-lab-boundary",
                "evidence": ["LIMITATIONS.md:7"], "limitations_artifact": "LIMITATIONS.md#sha256:lab"}))
        rc, out, _ = run("handoff-review", *L5, "--target", target,
                         "--record", handoff(scope="exact-target", equivalence="declared-lab"))
        check("handoff: a documented lab modification cannot satisfy an exact-target claim",
              rc == 0 and out.get("delivery_readiness") == "blocked")
        rc, out, _ = run("handoff-review", *L5, "--target", target,
                         "--record", handoff(scope="declared-lab", equivalence="declared-lab"))
        check("handoff: the same disclosed modification can be ready as a declared lab boundary",
              rc == 0 and out.get("delivery_readiness") == "ready")

        rc, out, _ = run("handoff-review", *L5, "--target", target,
                         "--record", handoff(scope="declared-lab", author_assistance=True))
        check("handoff: author coaching prevents a ready cold handoff",
              rc == 0 and out.get("delivery_readiness") == "needs_documentation")

        # A v1 engagement ledger upgrades in place on its next write; old runs remain readable.
        L6 = ["--ledger", os.path.join(tmp, "out", "ledger6")]
        run("init", *L6, "--target", target)
        ledger6_path = os.path.join(tmp, "out", "ledger6", "ledger.json")
        with open(ledger6_path) as f: old = _j.load(f)
        old["schema_version"] = 1
        for key in ("interventions", "handoff_reviews", "delivery_revision"):
            old.pop(key, None)
        with open(ledger6_path, "w") as f: _j.dump(old, f)
        rc, out, _ = run("summary", *L6)
        check("handoff: schema-v1 ledger remains readable", rc == 0 and out.get("intervention_count") == 0)
        compatible = {"stage": "setup", "unexpected_condition": "informational retry",
            "intervention": "reran once", "classification": "operator-error",
            "documented_before_run": True, "required_for_success": False,
            "changed_target_semantics": False, "changed_security_controls": False,
            "operator_knowledge_required": False, "evidence": ["run.log:1"]}
        run("intervention", *L6, "--target", target, "--record", json.dumps(compatible))
        with open(ledger6_path) as f: upgraded = _j.load(f)
        check("handoff: schema-v1 ledger persists as schema v2 on the next write",
              upgraded.get("schema_version") == 2 and upgraded.get("delivery_revision") == 1)

        print(f"\n{passed} passed, {failed} failed")
        return 1 if failed else 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

if __name__ == "__main__":
    sys.exit(main())
