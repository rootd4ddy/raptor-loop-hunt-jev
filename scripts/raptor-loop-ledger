#!/usr/bin/env python3
"""raptor-loop-ledger — engagement-scoped candidate state machine + evidence receipts.

The companion to `raptor-loop-kb`. Where the KB is the *cross-engagement* monotonic-
scrutiny memory, this ledger is the *within-engagement* enforcement layer that turns a
disposition from a sentence a reasoner emits into a **state transition the orchestrator
refuses until an evidence receipt exists** (raptor-loop-hunt SKILL.md, "Disposition
receipts"). The design principle, from the gpt-5.6-sol cross-model review:

    Models may PROPOSE claims and actions. Only the orchestrator and the execution
    harness may CERTIFY completion. A field a model could fabricate — the cross-vendor
    verdict, the oracle result — is populated from an ACTUAL recorded job, never from
    the reasoner's own text.

Storage is a run-dir sidecar (`<OUTPUT_DIR>/ledger/`), engagement-scoped like TRIED.md —
NOT the KB. It carries no cross-engagement state and never suppresses a candidate; it only
refuses a *transition* whose receipt is incomplete, leaving the candidate open.

Subcommands (all writers lock + atomic-write + fsync):
  init        --ledger DIR --target DIR
  add         --ledger DIR --target DIR (--record JSON | -)      -> registers a candidate (open)
  cross-vendor --ledger DIR (--job JSON | -)                     -> records a dispatched review job
  intervention --ledger DIR --target DIR (--record JSON | -)     -> records a workaround/tacit step
  intervention-resolve --ledger DIR --target DIR --intervention I (--record JSON | -)
  handoff-review --ledger DIR --target DIR (--record JSON | -)   -> records a fresh-operator replay
  transition  --ledger DIR --target DIR --candidate C --to STATE (--receipt JSON | -)
  pending-complete --ledger DIR --action A (--receipt JSON | -)
  file-close  --ledger DIR --file PATH                           -> refused while a sweep is open
  summary     --ledger DIR                                       -> report-ready one-line refs + open pendings
  conformance --ledger DIR [--target D --inventory F --covered F --omitted F --claims F
                            --require-handoff]
                                                                 -> deterministic closure gate (set-diffs)

Exit codes: 0 ok; 3 a transition, receipt, handoff, close, or conformance gate REFUSED; 2 usage/data error.
Pure stdlib. No RAPTOR imports, no sys.path manipulation.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCHEMA_VERSION = 2

# ---- bounds (mirror raptor-loop-kb's fail-closed discipline) ------------------
MAX_INPUT_BYTES = 1 * 1024 * 1024
MAX_LEDGER_BYTES = 64 * 1024 * 1024
MAX_CANDIDATES = 100000
MAX_PENDING = 100000
MAX_JOBS = 100000
MAX_INTERVENTIONS = 100000
MAX_HANDOFF_REVIEWS = 10000
MAX_FIELD_CHARS = 500
MAX_LIST_LEN = 32

# ---- controlled vocabularies (the receipt contract) --------------------------
STATES_TERMINAL = {"confirmed", "corrected", "rejected", "duplicate", "out-of-scope"}
STATES_OPEN = {"open", "needs-live-validation"}
ALL_STATES = STATES_TERMINAL | STATES_OPEN

ORACLE_CLASSES = {
    "sanitizer", "differential", "authorization", "state-change", "disclosure",
    "execution", "dos", "timing", "crypto-failure", "parser-differential",
    "policy-bypass", "race-invariant", "other",
}
REJECT_REASONS = {"unreachable", "non-exploitable", "expected-behavior", "duplicate", "out-of-scope"}
DELIVERY_VECTORS = {"path", "query", "body", "cookie", "header", "enc-request", "cli", "env", "config", "other"}
VECTOR_STATUS = {"tested", "not-applicable"}
# a live_validation closes only by RESOLVING the unknown one way or the other (or naming its blocker)
LIVE_OUTCOMES = {"vulnerable", "safe", "inconclusive"}
# uphold/overturn/inconclusive judge a rejection; concur_downgrade concurs with a *material downgrade*
# of a severe finding to Low (see the material-downgrade gate). A downgrade may cite only concur_downgrade.
REVIEW_VERDICTS = {"uphold", "overturn", "inconclusive", "concur_downgrade"}
PENDING_STATES = {"queued", "completed", "blocked"}
INTERVENTION_CLASSES = {
    "target-defect", "harness-defect", "documentation-defect",
    "environment-mismatch", "operator-error", "unresolved",
}
INTERVENTION_RESOLUTIONS = {
    "documented", "eliminated", "matches-claimed-deployment",
    "documented-lab-boundary", "accepted-blocker",
}
CLAIM_SCOPES = {"exact-target", "declared-lab"}
TARGET_EQUIVALENCE = {"exact-target", "declared-lab", "modified-target", "unknown"}
# bug classes that make a confirmed finding "proven-dirty" -> auto file sweep
DIRTY_BUG_CLASSES = {"memory-safety", "memory", "cwe-119", "cwe-120", "cwe-122",
                     "cwe-125", "cwe-787", "cwe-416", "cwe-415", "cwe-190", "cwe-476"}

# ---- severity lattice: the material-downgrade gate is DERIVED from these, never from a
# caller-chosen transition label (gpt-5.6-sol review). rank[potential] >= HIGH + effective-final
# classification collapses to Low/hardening/extinguished == a partial rejection carrying the full burden.
SEVERITY_RANK = {"": 0, "none": 0, "info": 1, "informational": 1, "hardening": 1,
                 "not-security": 1, "low": 1, "medium": 2, "med": 2, "high": 3, "critical": 4}
SEVERE_HWM = 3  # HIGH and above is a "severe high-water mark"
# a target severity at/below this rank is an "effective-Low" landing (a claim-extinguishing floor)
EFFECTIVE_LOW = 1
# a material downgrade is a >=2-LEVEL severity drop from a severe high-water mark. This catches
# Critical->Medium (4-2=2) as well as *->Low, while Critical->High (1) and High->Medium (1) stay
# ordinary corrections (gpt-5.6-sol amendment: the F-22 restore-RCE was capped Critical->Medium, a
# 2-level drop an "effective-Low only" rule would miss).
MIN_MATERIAL_DROP = 2
# sinks whose SEMANTICS decide impact — a confirmation that under-rates one of these must carry the
# sink-semantic fields (invocation mode, interpreter grammar/metacommands, execution identity), so a
# "confirmed medium" on a psql/shell sink cannot ship without the `\!`/argv analysis (F-22 lesson).
INTERPRETER_SINK_RE = ("psql", "sqlite", "mysql", "/bin/sh", "bash", " sh ", "exec", "spawn", "system(",
                       "eval", "deseriali", "pickle", "yaml.load", "marshal", "restore", "child_process")


def _sev_rank(s) -> int:
    return SEVERITY_RANK.get(str(s or "").strip().lower(), 0)


def _material_drop(hwm_rank: int, target_rank: int) -> bool:
    """A severe (>=HIGH) finding dropping >=2 severity levels to its target rating."""
    return hwm_rank >= SEVERE_HWM and (hwm_rank - target_rank) >= MIN_MATERIAL_DROP


PLACEHOLDER_TOKENS = {"", "test", "tbd", "todo", "placeholder", "xxx", "x", "a", "f", "na", "n/a",
                      "foo", "bar", "baz", "none", "-", "example", "sample", "dummy"}


def _looks_trivial(v) -> bool:
    """A placeholder-ish token: a known stub word or a <=2-char value carrying no locus."""
    v = str(v).strip().lower()
    return v in PLACEHOLDER_TOKENS or len(v) <= 2


def _looks_placeholder(rec: dict) -> bool:
    """A stub/placeholder candidate (all fields literal 'test', evidence file 'a' line 1) is an
    INVALID cell execution, not valid negative evidence — it must fail, forcing a rerun. This is the
    B3-style artifact that silently passed as a completed 'dry' cell (gpt-5.6-sol invalid-cell lint).
    Conservative on false-REJECTION (a short-but-real signature is fine as long as SOME locus is
    substantive); the real signal is 'no substantive content anywhere'."""
    sig = str(rec.get("finding_sig", "")).strip().lower()
    if sig in PLACEHOLDER_TOKENS or not sig:
        return True
    # a real candidate names at least one substantive locus (component / path / sink / entry point)
    return all(_looks_trivial(rec.get(k)) for k in ("component", "path", "sink", "entry_point"))


# ============================ shared primitives ================================
# (reused patterns from raptor-loop-kb: symlink-refusing storage, flock, atomic write)

def _sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _cap(text, n: int = MAX_FIELD_CHARS) -> str:
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:max(0, n - 1)] + "…"


def _now() -> float:
    # injectable for deterministic tests
    ov = os.environ.get("RAPTOR_LEDGER_FAKE_NOW")
    if ov:
        try:
            return float(ov)
        except ValueError:
            pass
    return time.time()


def _run_git(target: Path, *args: str) -> str:
    try:
        out = subprocess.run(["git", "-C", str(target), *args],
                             capture_output=True, text=True, timeout=20)
        return out.stdout if out.returncode == 0 else ""
    except Exception:
        return ""


def assert_safe_ledger_root(ledger_root: Path, target_root) -> Path:
    """Refuse a symlinked ledger path or one not owned by us. (Mirrors the KB helper's
    assert_safe_kb_root — the ledger MAY live under the output dir which may be under or
    beside the target, so we do NOT refuse target-adjacency here; we DO refuse symlinks
    and foreign ownership.)"""
    root = Path(os.path.abspath(ledger_root))
    cur = Path(root.parts[0])
    for seg in root.parts[1:]:
        cur = cur / seg
        if cur.is_symlink():
            raise SystemExit(f"ledger: refusing symlinked path component: {cur}")
    if root.exists():
        st = root.lstat()
        if st.st_uid != os.getuid():
            raise SystemExit("ledger: refusing ledger root not owned by current user")
    for leaf in ("ledger.json", ".ledger.lock"):
        p = root / leaf
        if p.is_symlink():
            raise SystemExit(f"ledger: refusing symlinked {leaf}")
    return root


def _ensure_root(ledger, target) -> Path:
    root = assert_safe_ledger_root(Path(ledger), Path(target) if target else None)
    root.mkdir(parents=True, exist_ok=True)
    return assert_safe_ledger_root(root, Path(target) if target else None)


def _resolve_under_root(target_root: Path, rel: str):
    if not isinstance(rel, str) or not rel:
        return None
    base = os.path.realpath(target_root)
    cand = os.path.realpath(os.path.join(base, rel))
    if cand == base or cand.startswith(base + os.sep):
        return Path(cand)
    return None


def _span_digest(target_root: Path, span: dict):
    if not isinstance(span, dict):
        return None
    p = _resolve_under_root(target_root, span.get("file", ""))
    if p is None or not p.is_file():
        return None
    try:
        lines = p.read_text(errors="replace").splitlines()
        s = max(1, int(span.get("start_line", 1)))
        e = int(span.get("end_line", s))
    except Exception:
        return None
    chunk = "\n".join(ln.rstrip() for ln in lines[s - 1:e])
    return _sha(chunk.encode())[:12]


class _Lock:
    def __init__(self, root: Path):
        self.path = Path(root) / ".ledger.lock"

    def __enter__(self):
        import fcntl
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        import fcntl
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


def _atomic_write(root: Path, data: dict) -> None:
    real = os.path.realpath(root)
    if (Path(real) / "ledger.json").is_symlink():
        raise SystemExit("ledger: refusing to overwrite symlinked ledger.json")
    fd, tmp = tempfile.mkstemp(dir=real, prefix=".ledger.json.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.flush(); os.fsync(fh.fileno())
        os.replace(tmp, os.path.join(real, "ledger.json"))
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    dfd = os.open(real, os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def _empty_ledger() -> dict:
    return {"schema_version": SCHEMA_VERSION, "target_identity": {}, "candidates": {},
            "pending_actions": [], "cross_vendor_jobs": {}, "closed_files": [],
            "interventions": {}, "handoff_reviews": [], "delivery_revision": 0, "updated": ""}


def _load(root: Path) -> dict:
    p = Path(root) / "ledger.json"
    if not p.is_file():
        return _empty_ledger()
    if p.stat().st_size > MAX_LEDGER_BYTES:
        raise SystemExit(f"ledger: ledger.json exceeds {MAX_LEDGER_BYTES} bytes; refusing")
    try:
        data = json.loads(p.read_text())
    except Exception as e:
        raise SystemExit(f"ledger: corrupt ledger.json ({e}); refusing")
    if not isinstance(data, dict):
        raise SystemExit("ledger: ledger.json is not an object; refusing")
    version = data.get("schema_version", 1)
    if not isinstance(version, int) or version < 1 or version > SCHEMA_VERSION:
        raise SystemExit(f"ledger: unsupported schema_version {version!r}; refusing")
    for k, v in _empty_ledger().items():
        data.setdefault(k, v)
    # Schema v2 adds delivery-only intervention and cold-handoff records. They are backward-
    # compatible optional collections, so a v1 ledger is upgraded on its next atomic write.
    data["schema_version"] = SCHEMA_VERSION
    # minimal structural typing
    for k, t in (("candidates", dict), ("pending_actions", list),
                 ("cross_vendor_jobs", dict), ("closed_files", list),
                 ("interventions", dict), ("handoff_reviews", list)):
        if not isinstance(data[k], t):
            raise SystemExit(f"ledger: field {k!r} wrong type; refusing")
    if not isinstance(data["delivery_revision"], int) or data["delivery_revision"] < 0:
        raise SystemExit("ledger: field 'delivery_revision' wrong type/value; refusing")
    return data


def _read_json_arg(record, file_or_dash) -> dict:
    if record is not None:
        raw = record
    elif file_or_dash and file_or_dash != "-":
        fp = Path(file_or_dash)
        if fp.stat().st_size > MAX_INPUT_BYTES:
            raise SystemExit(f"ledger: input exceeds {MAX_INPUT_BYTES} bytes; refusing")
        raw = fp.read_text()
    else:
        buf = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if len(buf) > MAX_INPUT_BYTES:
            raise SystemExit(f"ledger: stdin exceeds {MAX_INPUT_BYTES} bytes; refusing")
        raw = buf.decode("utf-8", "replace")
    try:
        obj = json.loads(raw)
    except json.JSONDecodeError as e:
        raise SystemExit(f"ledger: invalid JSON ({e}); refusing")
    if not isinstance(obj, dict):
        raise SystemExit("ledger: JSON record must be an object; refusing")
    return obj


def compute_identity(target: Path) -> dict:
    real = os.path.realpath(target)
    return {"target_path_id": _sha(real.encode())[:16],
            "target_path": real,
            "vcs_commit": _run_git(target, "rev-parse", "HEAD").strip(),
            # a VCS target whose commit we could resolve is bindable; a plain source drop is not.
            # Recording WHY lets conformance tell "no commits exist here" apart from "we lost it".
            "commit_bindable": bool((Path(real) / ".git").exists()),
            "release_label": _run_git(target, "describe", "--tags", "--always").strip()}


def _assert_target_matches(led: dict, target: str) -> None:
    """Every write must name the SAME tree the ledger was initialised for.

    Observed failure this prevents: a ledger initialised against one path while the audit ran on
    another. The identity then carries an empty commit and every receipt is written with
    `certified_commit: ""` — unbindable to any tree, and so unable to ever prove it certified the
    audited code. The mismatch is only detectable at closure, by which point the evidence is
    already unbindable. Catch it at the write, not at the gate."""
    want = (led.get("target_identity") or {}).get("target_path_id", "")
    if not want:
        return
    got = _sha(os.path.realpath(target).encode())[:16]
    if got != want:
        raise SystemExit(
            f"ledger: --target resolves to {got} but this ledger was initialised for {want}. "
            f"Refusing to mix trees in one engagement — receipts written against a different path "
            f"cannot be certified against the audited one. Point --target at the initialised tree, "
            f"or start a new ledger for the new target.")


# ============================ id helpers =======================================

def _candidate_id(rec: dict) -> str:
    key = "|".join(str(rec.get(k, "")) for k in ("finding_sig", "component", "path"))
    return "C-" + _sha(key.encode())[:12]


def _job_id(job: dict) -> str:
    key = "|".join(str(job.get(k, "")) for k in
                   ("model", "vendor", "target", "verdict", "evidence_hash",
                    "dispatched_at", "dispatched_by"))
    return "J-" + _sha(key.encode())[:12]


def _receipt_id(candidate_id: str, to_state: str, receipt: dict) -> str:
    key = candidate_id + "|" + to_state + "|" + json.dumps(receipt, sort_keys=True)[:4000]
    return "R-" + _sha(key.encode())[:10]


def _action_id(target_cid: str, kind: str) -> str:
    return "A-" + _sha((target_cid + "|" + kind).encode())[:10]


def _intervention_id(rec: dict) -> str:
    return "I-" + _sha(json.dumps(rec, sort_keys=True, separators=(",", ":")).encode())[:12]


def _handoff_review_id(rec: dict, at: str) -> str:
    key = at + "|" + json.dumps(rec, sort_keys=True)[:8000]
    return "H-" + _sha(key.encode())[:12]


def _nonempty_list(value) -> bool:
    return isinstance(value, list) and bool([v for v in value if str(v).strip()])


def _cap_list(value) -> list:
    return [_cap(v) for v in value[:MAX_LIST_LEN] if str(v).strip()]


def _validate_intervention_record(rec: dict) -> tuple[bool, list]:
    errs = []
    for field in ("stage", "unexpected_condition", "intervention"):
        if not str(rec.get(field, "")).strip():
            errs.append(f"{field} required")
    if rec.get("classification") not in INTERVENTION_CLASSES:
        errs.append(f"classification must be one of {sorted(INTERVENTION_CLASSES)}")
    for field in ("documented_before_run", "required_for_success",
                  "changed_target_semantics", "changed_security_controls",
                  "operator_knowledge_required"):
        if not isinstance(rec.get(field), bool):
            errs.append(f"{field} required (boolean)")
    if not _nonempty_list(rec.get("evidence")):
        errs.append("evidence must be a non-empty list of logs, commands, paths, or observations")
    elif len(rec["evidence"]) > MAX_LIST_LEN:
        errs.append(f"evidence has {len(rec['evidence'])} entries; cap is {MAX_LIST_LEN}")
    return (not errs, errs)


def _validate_intervention_resolution(rec: dict) -> tuple[bool, list]:
    errs = []
    outcome = rec.get("resolution")
    if outcome not in INTERVENTION_RESOLUTIONS:
        errs.append(f"resolution must be one of {sorted(INTERVENTION_RESOLUTIONS)}")
    if not _nonempty_list(rec.get("evidence")):
        errs.append("evidence must be a non-empty list proving the resolution")
    elif len(rec["evidence"]) > MAX_LIST_LEN:
        errs.append(f"evidence has {len(rec['evidence'])} entries; cap is {MAX_LIST_LEN}")
    required = {
        "documented": "instructions_artifact",
        "matches-claimed-deployment": "deployment_evidence",
        "documented-lab-boundary": "limitations_artifact",
        "eliminated": "verification_artifact",
        "accepted-blocker": "blocker",
    }.get(outcome)
    if required and not str(rec.get(required, "")).strip():
        errs.append(f"resolution={outcome} requires {required}")
    return (not errs, errs)


def _validate_marker(name: str, marker) -> list:
    if not isinstance(marker, dict):
        return [f"{name} must be an object {{expected, observed, passed}}"]
    errs = []
    if not str(marker.get("expected", "")).strip():
        errs.append(f"{name}.expected required")
    if not str(marker.get("observed", "")).strip():
        errs.append(f"{name}.observed required")
    if not isinstance(marker.get("passed"), bool):
        errs.append(f"{name}.passed required (boolean)")
    return errs


def _validate_handoff_review(rec: dict) -> tuple[bool, list]:
    errs = []
    for field in ("reviewer", "package_digest", "environment_digest", "instructions_artifact"):
        if not str(rec.get(field, "")).strip():
            errs.append(f"{field} required")
    for field in ("reviewer_independent", "author_assistance"):
        if not isinstance(rec.get(field), bool):
            errs.append(f"{field} required (boolean)")
    if rec.get("claim_scope") not in CLAIM_SCOPES:
        errs.append(f"claim_scope must be one of {sorted(CLAIM_SCOPES)}")
    if rec.get("target_equivalence") not in TARGET_EQUIVALENCE:
        errs.append(f"target_equivalence must be one of {sorted(TARGET_EQUIVALENCE)}")
    errs.extend(_validate_marker("success_marker", rec.get("success_marker")))
    errs.extend(_validate_marker("negative_control", rec.get("negative_control")))
    if not _nonempty_list(rec.get("observed_artifacts")):
        errs.append("observed_artifacts must be a non-empty list")
    elif len(rec["observed_artifacts"]) > MAX_LIST_LEN:
        errs.append(f"observed_artifacts has {len(rec['observed_artifacts'])} entries; cap is {MAX_LIST_LEN}")
    return (not errs, errs)


def _delivery_assessment(led: dict) -> dict:
    """Recompute owner-delivery readiness from the latest cold handoff and ALL interventions.

    This is deliberately separate from candidate state and `report_blocking`: a technically proven
    finding can remain proven while its package is not yet reproducible by a fresh operator.
    """
    reviews = led.get("handoff_reviews", [])
    if not reviews:
        return {"delivery_readiness": "blocked", "delivery_blocking": True,
                "latest_handoff_review": None,
                "blocking_reasons": ["no fresh-operator handoff review recorded"]}

    review = reviews[-1]
    reasons = []
    levels = []

    def block(level: str, reason: str) -> None:
        levels.append(level)
        reasons.append(reason)

    review_ok, review_errs = _validate_handoff_review(review)
    if not review_ok:
        for err in review_errs:
            block("blocked", f"latest handoff review fails the current receipt contract: {err}")
    if review.get("delivery_revision") != led.get("delivery_revision"):
        block("blocked", "latest handoff review predates a delivery-affecting intervention or resolution")

    if review.get("reviewer_independent") is not True:
        block("blocked", "handoff reviewer was not independent of PoC construction")
    if review.get("author_assistance") is not False:
        block("needs_documentation", "fresh operator required author assistance")
    if (review.get("success_marker") or {}).get("passed") is not True:
        block("blocked", "fresh operator did not reproduce the exact success marker")
    if (review.get("negative_control") or {}).get("passed") is not True:
        block("blocked", "fresh operator did not pass the causal negative control")

    scope = review.get("claim_scope")
    equivalence = review.get("target_equivalence")
    if scope == "exact-target" and equivalence != "exact-target":
        block("blocked", f"exact-target claim used target_equivalence={equivalence!r}")
    if scope == "declared-lab" and equivalence not in ("exact-target", "declared-lab"):
        block("blocked", f"declared-lab claim used target_equivalence={equivalence!r}")

    doc_resolutions = {"documented", "eliminated", "matches-claimed-deployment",
                       "documented-lab-boundary"}
    for iid, intervention in sorted(led.get("interventions", {}).items()):
        intervention_ok, intervention_errs = _validate_intervention_record(intervention)
        if not intervention_ok:
            for err in intervention_errs:
                block("blocked", f"{iid} fails the current intervention contract: {err}")
        resolution_record = intervention.get("resolution") or {}
        resolution = resolution_record.get("resolution", "")
        if resolution_record:
            resolution_ok, resolution_errs = _validate_intervention_resolution(resolution_record)
            if not resolution_ok:
                for err in resolution_errs:
                    block("blocked", f"{iid} resolution fails the current receipt contract: {err}")
        classification = intervention.get("classification")
        if resolution == "accepted-blocker":
            block("blocked", f"{iid} remains an accepted delivery blocker")
            continue
        if intervention.get("required_for_success") and not intervention.get("documented_before_run") \
                and resolution not in doc_resolutions:
            if classification in ("documentation-defect", "operator-error"):
                level = "needs_documentation"
            elif classification in ("environment-mismatch", "harness-defect"):
                level = "needs_environment_fix"
            else:
                level = "blocked"
            block(level, f"{iid} is a required, undocumented intervention with no accepted resolution")
        if intervention.get("changed_target_semantics") or intervention.get("changed_security_controls"):
            allowed = {"eliminated", "matches-claimed-deployment"}
            if scope == "declared-lab":
                allowed.add("documented-lab-boundary")
            if resolution not in allowed:
                block("blocked", f"{iid} changed target/security semantics and is not valid for {scope}")

    priority = {"ready": 0, "needs_documentation": 1, "needs_environment_fix": 2, "blocked": 3}
    readiness = max(levels, key=lambda x: priority[x]) if levels else "ready"
    return {"delivery_readiness": readiness, "delivery_blocking": readiness != "ready",
            "latest_handoff_review": review.get("review_id"), "blocking_reasons": reasons}


# ============================ receipt validators ===============================
# Each returns (ok: bool, errors: list[str]). The gate: no receipt, no transition.

def _validate_confirmation(receipt: dict, bug_class: str) -> tuple[bool, list]:
    errs = []
    oc = receipt.get("oracle_class")
    if oc not in ORACLE_CLASSES:
        errs.append(f"oracle_class must be one of {sorted(ORACLE_CLASSES)}; got {oc!r}")
    if not str(receipt.get("replay_command", "")).strip():
        errs.append("replay_command required (the script/fixture id that reproduces it)")
    if not str(receipt.get("input_hash", "")).strip():
        errs.append("input_hash required (hash of the triggering input)")
    if not str(receipt.get("expected_predicate", "")).strip():
        errs.append("expected_predicate required (a machine-checkable signal, not 'looks exploitable')")
    arts = receipt.get("observed_artifacts")
    if not isinstance(arts, list) or not arts:
        errs.append("observed_artifacts must be a non-empty list of artifact hashes/paths")
    # anti-inflation: a bare crash (dos oracle) cannot certify memory-corruption exploitability
    bc = (bug_class or "").lower()
    if oc == "dos" and bc in DIRTY_BUG_CLASSES:
        errs.append("oracle_class=dos (bare crash) cannot confirm a memory-safety EXPLOITABILITY "
                    "claim — use a sanitizer-class receipt, or file this as its DoS impact")
    return (not errs, errs)


def _review_job_binds_candidate(receipt: dict, led: dict, cand: dict) -> tuple[bool, list]:
    """A cross-vendor review must be about THIS candidate. Without this, one `uphold` job can be
    cited by every rejection in the run — the material-downgrade path already checked candidate
    binding; the rejection path did not (gpt-5.6-sol review of this change)."""
    ir = receipt.get("independent_review")
    if not isinstance(ir, dict):
        return (True, [])          # absence is already reported by _validate_rejection
    job = led.get("cross_vendor_jobs", {}).get(ir.get("job_id"))
    if not isinstance(job, dict) or cand is None:
        return (True, [])          # existence is already reported by _validate_rejection
    tgt = str(job.get("target", ""))
    if tgt and tgt not in (cand.get("candidate_id", ""), cand.get("finding_sig", "")):
        return (False, [f"cross-vendor job {ir.get('job_id')} reviewed {tgt!r}, not this candidate "
                        f"({cand.get('candidate_id')} / {cand.get('finding_sig')!r}) — a review of a "
                        "different finding is not a review of this one"])
    return (True, [])


def _validate_rejection(receipt: dict, ledger: dict) -> tuple[bool, list]:
    errs = []
    reason = receipt.get("rejection_reason")
    if reason not in REJECT_REASONS:
        errs.append(f"rejection_reason must be one of {sorted(REJECT_REASONS)}; got {reason!r}")
    if not str(receipt.get("counter_hypothesis", "")).strip():
        errs.append("counter_hypothesis required (the concrete proposition that kills the finding)")
    vm = receipt.get("vector_matrix")
    if not isinstance(vm, list) or not vm:
        errs.append("vector_matrix must be a non-empty list; a bare vector list proves no test ran")
    elif len(vm) > MAX_LIST_LEN:
        errs.append(f"vector_matrix has {len(vm)} rows; cap is {MAX_LIST_LEN}")
    else:
        # COMPLETENESS, not merely non-emptiness. SKILL.md ("A REJECTION carries the finding's full
        # proof burden") demands the barrier hold on ALL of the sink's input sources. A vector that
        # is silently absent is the canonical false-kill shape: the kill tested the URL path only,
        # and the query-param vector executed live. So every vector is stated explicitly — `tested`
        # with evidence, or `not-applicable` with a rationale. Unexamined ⇒ unknown, never absent.
        seen = [row.get("vector") for row in vm if isinstance(row, dict)]
        missing = sorted(DELIVERY_VECTORS - set(seen))
        dupes = sorted({v for v in seen if v in DELIVERY_VECTORS and seen.count(v) > 1})
        if missing:
            errs.append(f"vector_matrix is INCOMPLETE — no row for {missing}. Every delivery vector "
                        f"needs an explicit disposition: `tested` (command_or_fixture + observed) or "
                        f"`not-applicable` (rationale). A missing row is an untested vector sold as a "
                        f"complete kill — the exact single-vector refutation this gate exists to stop.")
        if dupes:
            errs.append(f"vector_matrix has duplicate rows for {dupes}; exactly one row per vector")
        for i, row in enumerate(vm):
            if not isinstance(row, dict):
                errs.append(f"vector_matrix[{i}] must be an object"); continue
            v = row.get("vector")
            if v not in DELIVERY_VECTORS:
                errs.append(f"vector_matrix[{i}].vector must be one of {sorted(DELIVERY_VECTORS)}; got {v!r}")
            st = row.get("status")
            if st not in VECTOR_STATUS:
                errs.append(f"vector_matrix[{i}].status must be one of {sorted(VECTOR_STATUS)}; got {st!r}")
            elif st == "tested":
                if not str(row.get("command_or_fixture", "")).strip():
                    errs.append(f"vector_matrix[{i}] tested -> command_or_fixture required")
                if not str(row.get("observed", "")).strip():
                    errs.append(f"vector_matrix[{i}] tested -> observed required (what the test showed)")
            elif st == "not-applicable":
                if not str(row.get("rationale", "")).strip():
                    errs.append(f"vector_matrix[{i}] not-applicable -> rationale required "
                                "(why this vector cannot reach the sink)")
    # reachability kills carry build/config gating evidence
    if reason == "unreachable":
        g = receipt.get("gating")
        if not isinstance(g, dict):
            errs.append("rejection_reason=unreachable requires a gating object "
                        "(build_digest, config_digest, route_or_symbol_evidence)")
        else:
            for f in ("build_digest", "config_digest", "route_or_symbol_evidence"):
                if not str(g.get(f, "")).strip():
                    errs.append(f"gating.{f} required for an unreachable kill (observed, not asserted)")
    # INVARIANT kills (gpt-5.6-sol): "X is always single-owner / can only ever be Y" is the F-07/F-20
    # failure — a construction path is not an invariant. Require the FULL writer inventory + a challenge.
    ch = str(receipt.get("counter_hypothesis", "")).lower()
    INV_SIGNAL = ("single-owner", "single owner", "per-owner", "one owner", "sole owner", "uniquely owned",
                  "at most one", "only one", "owned by the", "always ", "only ever", "guaranteed",
                  "invariant", "can only", "cannot be", "never ", "by construction", "always scoped")
    if receipt.get("basis") == "invariant" or any(s in ch for s in INV_SIGNAL):
        inv = receipt.get("invariant_challenge")
        if not isinstance(inv, dict):
            errs.append("this kill relies on an INVARIANT (e.g. 'always single-owner') -> requires an "
                        "invariant_challenge {invariant, enforcement_site, all_writers[], mutation_paths[], "
                        "counterexample_tested} — a construction path is NOT proof the invariant holds")
        else:
            if not str(inv.get("invariant", "")).strip():
                errs.append("invariant_challenge.invariant required (state the exact invariant relied on)")
            if not str(inv.get("enforcement_site", "")).strip():
                errs.append("invariant_challenge.enforcement_site required (where it is enforced)")
            aw = inv.get("all_writers")
            # each writer must be a SUBSTANTIVE locus (file:sym/route), not a placeholder like "x"
            good_writers = [w for w in aw if isinstance(aw, list) and isinstance(w, str)
                            and not _looks_trivial(w)]
            if not isinstance(aw, list) or not good_writers:
                errs.append("invariant_challenge.all_writers[] required with SUBSTANTIVE entries — enumerate "
                            "EVERY writer to the invariant-bearing field/relation incl. bulk/import/restore/"
                            "deser (the F-07 miss: PUT /assets {duplicateId} was an unlisted writer)")
            if not isinstance(inv.get("mutation_paths"), list):
                errs.append("invariant_challenge.mutation_paths[] required (the write/import/bulk paths that "
                            "could violate the invariant)")
            if not isinstance(inv.get("counterexample_tested"), bool):
                errs.append("invariant_challenge.counterexample_tested required (bool: did you try to break it)")
    # INTENDED-BEHAVIOR kills: "a sibling endpoint already exposes it" is NOT product intent. Require a
    # real policy artifact WITH the sanctioning quote; a contrary privacy control (publicUsers) is evidence
    # AGAINST, not for (F-18). NB: the ledger enforces the receipt's STRUCTURE — whether the artifact truly
    # sanctions the behavior is the cross-vendor judge's semantic call, not a string check.
    if reason == "expected-behavior":
        pe = receipt.get("policy_evidence")
        if not isinstance(pe, dict) or not str(pe.get("artifact", "")).strip() \
                or not str(pe.get("span_or_url", "")).strip() or not str(pe.get("quote", "")).strip():
            errs.append("rejection_reason=expected-behavior requires policy_evidence {artifact, span_or_url, "
                        "quote} citing an explicit spec/doc/config whose QUOTE sanctions this — a sibling "
                        "exposure or 'another endpoint does it' is not intent (it may be a second bug)")
    # cross-vendor: MUST reference a recorded orchestrator-dispatched job that UPHELD the kill.
    ir = receipt.get("independent_review")
    job_id = ir.get("job_id") if isinstance(ir, dict) else None
    if not job_id:
        errs.append("independent_review.job_id required — the orchestrator-dispatched cross-vendor "
                    "review (record it first via `cross-vendor`); a self-written verdict is fraud")
    else:
        job = ledger.get("cross_vendor_jobs", {}).get(job_id)
        if not job:
            errs.append(f"independent_review.job_id={job_id!r} is not a recorded cross-vendor job "
                        "(the reasoner cannot invent one — the orchestrator records it via `cross-vendor`)")
        elif job.get("verdict") != "uphold":
            errs.append(f"cross-vendor job {job_id} verdict is {job.get('verdict')!r}, not 'uphold' — "
                        "an overturn/inconclusive review does NOT permit rejection")
    return (not errs, errs)


def _validate_needs_live(receipt: dict) -> tuple[bool, list]:
    errs = []
    if not str(receipt.get("safe_test", "")).strip():
        errs.append("safe_test required (the exact request/command + expected vulnerable-vs-safe response)")
    if not str(receipt.get("potential_severity", "")).strip():
        errs.append("potential_severity required (worst case if the unseen layer is insecure)")
    return (not errs, errs)


def _validate_dirty_sweep(receipt: dict) -> tuple[bool, list]:
    errs = []
    er = receipt.get("enumeration_recipe")
    if not isinstance(er, dict) or not (er.get("commands") or er.get("semantic_queries") or er.get("callgraph_root")):
        errs.append("enumeration_recipe required (commands / semantic_queries / callgraph_root) — "
                    "the re-runnable derivation of the candidate sibling set")
    ds = receipt.get("discovered_sites")
    if not isinstance(ds, list):
        errs.append("discovered_sites must be a list (each: site + disposition); empty is allowed but must be explicit")
    if not str(receipt.get("site_set_hash", "")).strip():
        errs.append("site_set_hash required (re-runnable digest the judge diffs against)")
    return (not errs, errs)


# ============================ subcommands ======================================

def cmd_init(args) -> int:
    root = _ensure_root(args.ledger, args.target)
    with _Lock(root):
        led = _load(root)
        if not led.get("target_identity"):
            led["target_identity"] = compute_identity(Path(args.target))
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"ledger": str(root), "target_identity": led["target_identity"]}, indent=2))
    return 0


def cmd_add(args) -> int:
    root = _ensure_root(args.ledger, args.target)
    _assert_target_matches(_load(root), args.target)
    rec = _read_json_arg(args.record, args.file)
    if not str(rec.get("finding_sig", "")).strip():
        raise SystemExit("ledger add: record.finding_sig required (stable candidate signature)")
    if _looks_placeholder(rec):
        raise SystemExit("ledger add: refusing a placeholder/stub candidate (fields look like 'test'/'a'/"
                         "empty) — this is an invalid cell execution, not a finding; rerun the cell")
    cid = _candidate_id(rec)
    with _Lock(root):
        led = _load(root)
        if len(led["candidates"]) >= MAX_CANDIDATES:
            raise SystemExit("ledger: candidate cap reached; refusing")
        existing = led["candidates"].get(cid)
        if existing is None:
            pot = _cap(rec.get("potential_severity", ""), 16)
            led["candidates"][cid] = {
                "candidate_id": cid,
                "finding_sig": _cap(rec.get("finding_sig", ""), 128),
                "component": _cap(rec.get("component", ""), 256),
                "path": _cap(rec.get("path", ""), 256),
                "entry_point": _cap(rec.get("entry_point", ""), 256),
                "sink": _cap(rec.get("sink", ""), 256),
                "violated_invariant": _cap(rec.get("violated_invariant", "")),
                "bug_class": _cap(rec.get("bug_class", ""), 64),
                "created_by": _cap(rec.get("created_by", ""), 128),
                "created_commit": _cap(rec.get("commit", ""), 64),
                "potential_severity": pot,
                # append-only severe high-water mark — the material-downgrade gate reads THIS,
                # not the current re-rate, so High->Medium->Low laundering cannot reset it.
                "potential_hwm": pot if _sev_rank(pot) >= SEVERE_HWM else "",
                "state": "open",
                "state_history": [],
                "receipts": {},
            }
        else:
            # raise the high-water mark if a later add reports a more severe potential (never lower it)
            pot = _cap(rec.get("potential_severity", ""), 16)
            if _sev_rank(pot) > _sev_rank(existing.get("potential_hwm", "")):
                existing["potential_hwm"] = pot
        cand = led["candidates"][cid]
        # severe-sink hypothesis (potential>=HIGH reaching a named sink) auto-enqueues a SINK-KEYED
        # trigger-path enumeration — it blocks a material downgrade + the sink's coverage, not the file.
        if _sev_rank(cand.get("potential_hwm", "")) >= SEVERE_HWM and str(cand.get("sink", "")).strip():
            _enqueue_sink(led, cand, "severe_sink_hypothesis", "enumerate_trigger_paths")
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"candidate_id": cid, "state": led["candidates"][cid]["state"],
                      "new": existing is None}))
    return 0


def cmd_cross_vendor(args) -> int:
    root = _ensure_root(args.ledger, None)
    job = _read_json_arg(args.job, args.file)
    verdict = job.get("verdict")
    if verdict not in REVIEW_VERDICTS:
        raise SystemExit(f"ledger cross-vendor: verdict must be one of {sorted(REVIEW_VERDICTS)}; got {verdict!r}")
    if not str(job.get("model", "")).strip():
        raise SystemExit("ledger cross-vendor: model required (the reviewing model id)")
    if not str(job.get("target", "")).strip():
        raise SystemExit("ledger cross-vendor: target required (candidate_id or finding_sig under review)")
    # HONEST SCOPE (gpt-5.6-sol): nothing inside a single-process CLI can PROVE a second vendor
    # produced this verdict — vendor/model/hash all arrive as caller JSON. What these fields buy is
    # *recorded provenance*: the reviewing vendor is named and distinguishable from the model label,
    # and the review is bound to the evidence it read. Call it orchestrator-recorded review
    # provenance, never "cross-vendor authentication". Real authentication needs a provider-signed
    # response from a trust domain the CLI does not control.
    if not str(job.get("vendor", "")).strip():
        raise SystemExit("ledger cross-vendor: vendor required (the REVIEWING vendor, distinct from "
                         "the model label — 'kimi-judge-J1' names a seat, not a vendor)")
    if not str(job.get("evidence_hash", "")).strip():
        raise SystemExit("ledger cross-vendor: evidence_hash required (a digest over the exact "
                         "evidence the reviewer read; an unbound verdict reviews nothing)")
    if not str(job.get("dispatched_by", "")).strip():
        raise SystemExit("ledger cross-vendor: dispatched_by required — it must be stated, never "
                         "defaulted (it previously defaulted to the literal 'orchestrator', so the "
                         "field meant to evidence orchestrator dispatch asserted it by itself)")
    job.setdefault("dispatched_at", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now())))
    jid = _job_id(job)
    rec = {"job_id": jid, "model": _cap(job.get("model", ""), 64),
           "vendor": _cap(job.get("vendor", ""), 64),
           "target": _cap(job.get("target", ""), 128), "verdict": verdict,
           "evidence_hash": _cap(job.get("evidence_hash", ""), 128),
           "dispatched_at": _cap(job.get("dispatched_at", ""), 40),
           "dispatched_by": _cap(job.get("dispatched_by", ""), 64)}
    with _Lock(root):
        led = _load(root)
        if len(led["cross_vendor_jobs"]) >= MAX_JOBS:
            raise SystemExit("ledger: cross-vendor job cap reached; refusing")
        # jobs are IMMUTABLE: an id collision must not silently rewrite a recorded verdict
        prev = led["cross_vendor_jobs"].get(jid)
        if prev is not None and prev != rec:
            raise SystemExit(f"ledger cross-vendor: job {jid} already recorded with different "
                             "content; review jobs are immutable")
        led["cross_vendor_jobs"][jid] = rec
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"job_id": jid, "verdict": verdict}))
    return 0


def cmd_intervention(args) -> int:
    """Record a workaround or tacit operator intervention without changing candidate state."""
    root = _ensure_root(args.ledger, args.target)
    _assert_target_matches(_load(root), args.target)
    rec = _read_json_arg(args.record, args.file)
    ok, errs = _validate_intervention_record(rec)
    if not ok:
        print(json.dumps({"intervention": "REFUSED", "errors": errs}, indent=2))
        return 3
    iid = _intervention_id(rec)
    with _Lock(root):
        led = _load(root)
        if len(led["interventions"]) >= MAX_INTERVENTIONS and iid not in led["interventions"]:
            raise SystemExit("ledger: intervention cap reached; refusing")
        existing = led["interventions"].get(iid)
        if existing is None:
            led["interventions"][iid] = {
                "intervention_id": iid,
                "stage": _cap(rec.get("stage", ""), 128),
                "unexpected_condition": _cap(rec.get("unexpected_condition", "")),
                "intervention": _cap(rec.get("intervention", "")),
                "candidate_id": _cap(rec.get("candidate_id", ""), 32),
                "classification": rec["classification"],
                "documented_before_run": rec["documented_before_run"],
                "required_for_success": rec["required_for_success"],
                "changed_target_semantics": rec["changed_target_semantics"],
                "changed_security_controls": rec["changed_security_controls"],
                "operator_knowledge_required": rec["operator_knowledge_required"],
                "evidence": _cap_list(rec["evidence"]),
                "resolution": None,
                "resolution_history": [],
                "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now())),
            }
            led["delivery_revision"] += 1
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    assessment = _delivery_assessment(led)
    print(json.dumps({"intervention": "RECORDED", "intervention_id": iid,
                      "new": existing is None, **assessment}, indent=2))
    return 0


def cmd_intervention_resolve(args) -> int:
    root = _ensure_root(args.ledger, args.target)
    _assert_target_matches(_load(root), args.target)
    rec = _read_json_arg(args.record, args.file)
    ok, errs = _validate_intervention_resolution(rec)
    if not ok:
        print(json.dumps({"intervention_resolution": "REFUSED", "intervention_id": args.intervention,
                          "errors": errs}, indent=2))
        return 3
    with _Lock(root):
        led = _load(root)
        intervention = led["interventions"].get(args.intervention)
        if intervention is None:
            raise SystemExit(f"ledger intervention-resolve: unknown intervention {args.intervention!r}")
        certified_commit = _cap(_run_git(Path(args.target), "rev-parse", "HEAD").strip(), 64)
        if not certified_commit and (led.get("target_identity") or {}).get("commit_bindable"):
            raise SystemExit("ledger intervention-resolve: target HEAD is unresolvable; refusing an "
                             "intervention resolution that cannot bind to the reviewed tree")
        previous = intervention.get("resolution")
        resolution_history = intervention.setdefault("resolution_history", [])
        if not isinstance(resolution_history, list):
            raise SystemExit("ledger intervention-resolve: resolution_history wrong type; refusing")
        if previous is not None and not resolution_history:
            # Backward-compatible preservation for an early schema-v2 record written before
            # resolution history existed.
            resolution_history.append(previous)
        if len(resolution_history) >= MAX_LIST_LEN:
            raise SystemExit(f"ledger intervention-resolve: resolution history cap "
                             f"({MAX_LIST_LEN}) reached; start a new engagement ledger")
        resolution_record = {
            "resolution": rec["resolution"],
            "evidence": _cap_list(rec["evidence"]),
            "instructions_artifact": _cap(rec.get("instructions_artifact", ""), 256),
            "deployment_evidence": _cap(rec.get("deployment_evidence", ""), 256),
            "limitations_artifact": _cap(rec.get("limitations_artifact", ""), 256),
            "verification_artifact": _cap(rec.get("verification_artifact", ""), 256),
            "blocker": _cap(rec.get("blocker", "")),
            "certified_commit": certified_commit,
        }
        if previous is not None and all(previous.get(k) == v for k, v in resolution_record.items()):
            print(json.dumps({"intervention_resolution": "REFUSED",
                              "intervention_id": args.intervention,
                              "errors": ["identical resolution already recorded; receipts are append-only"]},
                             indent=2))
            return 3
        resolution_record["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        resolution_history.append(resolution_record)
        intervention["resolution"] = resolution_record
        led["delivery_revision"] += 1
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"intervention_resolution": "ACCEPTED", "intervention_id": args.intervention,
                      **_delivery_assessment(led)}, indent=2))
    return 0


def cmd_handoff_review(args) -> int:
    root = _ensure_root(args.ledger, args.target)
    _assert_target_matches(_load(root), args.target)
    rec = _read_json_arg(args.record, args.file)
    ok, errs = _validate_handoff_review(rec)
    if not ok:
        print(json.dumps({"handoff_review": "REFUSED", "errors": errs}, indent=2))
        return 3
    with _Lock(root):
        led = _load(root)
        if len(led["handoff_reviews"]) >= MAX_HANDOFF_REVIEWS:
            raise SystemExit("ledger: handoff review cap reached; refusing")
        certified_commit = _cap(_run_git(Path(args.target), "rev-parse", "HEAD").strip(), 64)
        if not certified_commit and (led.get("target_identity") or {}).get("commit_bindable"):
            raise SystemExit("ledger handoff-review: target HEAD is unresolvable; refusing a review "
                             "that cannot bind to the reviewed tree")
        at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        review = {
            "reviewer": _cap(rec.get("reviewer", ""), 128),
            "reviewer_independent": rec["reviewer_independent"],
            "package_digest": _cap(rec.get("package_digest", ""), 128),
            "environment_digest": _cap(rec.get("environment_digest", ""), 128),
            "instructions_artifact": _cap(rec.get("instructions_artifact", ""), 256),
            "author_assistance": rec["author_assistance"],
            "claim_scope": rec["claim_scope"],
            "target_equivalence": rec["target_equivalence"],
            "success_marker": {"expected": _cap(rec["success_marker"].get("expected", "")),
                               "observed": _cap(rec["success_marker"].get("observed", "")),
                               "passed": rec["success_marker"]["passed"]},
            "negative_control": {"expected": _cap(rec["negative_control"].get("expected", "")),
                                 "observed": _cap(rec["negative_control"].get("observed", "")),
                                 "passed": rec["negative_control"]["passed"]},
            "observed_artifacts": _cap_list(rec["observed_artifacts"]),
            "delivery_revision": led["delivery_revision"],
            "certified_commit": certified_commit,
            "at": at,
        }
        review["review_id"] = _handoff_review_id(review, at)
        led["handoff_reviews"].append(review)
        assessment = _delivery_assessment(led)
        review["delivery_readiness_at_recording"] = assessment["delivery_readiness"]
        review["blocking_reasons_at_recording"] = assessment["blocking_reasons"]
        led["updated"] = at
        _atomic_write(root, led)
    print(json.dumps({"handoff_review": "RECORDED", "review_id": review["review_id"],
                      **_delivery_assessment(led)}, indent=2))
    return 0


def _enqueue(led: dict, target_cid: str, trigger: str, required_action: str) -> dict:
    aid = _action_id(target_cid, required_action)
    for a in led["pending_actions"]:
        if a.get("action_id") == aid and a.get("state") != "completed":
            return a  # idempotent: don't double-enqueue an open action
    action = {"action_id": aid, "trigger": trigger, "target": target_cid,
              "required_action": required_action, "state": "queued",
              "completion_receipt": None,
              "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))}
    if len(led["pending_actions"]) < MAX_PENDING:
        led["pending_actions"].append(action)
    return action


def _sink_key(cand: dict) -> str:
    """Stable id for a sink so the enumeration action is keyed by the SINK, not per-endpoint —
    several candidates reaching the same sink share one enumeration (gpt-5.6-sol review, missing #1)."""
    return "S-" + hashlib.sha256((cand.get("sink", "") or cand.get("component", "")).encode()).hexdigest()[:16]


def _enqueue_sink(led: dict, cand: dict, trigger: str, required_action: str) -> dict:
    skey = _sink_key(cand)
    aid = "A-" + hashlib.sha256((skey + "|" + required_action).encode()).hexdigest()[:16]
    for a in led["pending_actions"]:
        if a.get("action_id") == aid and a.get("state") != "completed":
            if cand["candidate_id"] not in a.setdefault("candidates", []):
                a["candidates"].append(cand["candidate_id"])
            return a
    action = {"action_id": aid, "trigger": trigger, "target": skey, "sink_key": skey,
              "candidates": [cand["candidate_id"]], "required_action": required_action,
              "state": "queued", "completion_receipt": None,
              "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))}
    if len(led["pending_actions"]) < MAX_PENDING:
        led["pending_actions"].append(action)
    return action


GATING_DIGEST_KEYS = {"build", "build_digest", "route", "route_or_symbol_evidence", "sink",
                      "sink_digest", "config", "config_digest", "commit"}


def _cand_hwm(cand: dict) -> int:
    """Recompute the severe high-water-mark defensively — max of the stored hwm AND the created
    potential (so lowering `potential_hwm` alone via a direct edit does not shrink the severity)."""
    return max(_sev_rank(cand.get("potential_hwm", "")), _sev_rank(cand.get("potential_severity", "")))


def _canonical_preserves(led: dict, receipt: dict, self_cid: str = "") -> bool:
    """A duplicate/out-of-scope of a severe finding is only NON-material when it links to a canonical
    candidate that EXISTS, is still severe, is not the finding itself, and is not itself
    extinguished-to-Low (gpt-5.6-sol fix #1 + self-reference guard — a nonblank string, a self-pointer,
    or a downgraded canonical is not a preservation)."""
    ref = str(receipt.get("canonical_finding", "")).strip()
    if not ref:
        return False
    canon = _candidate_by_ref(led, ref)
    if canon is None or canon.get("candidate_id") == self_cid or _cand_hwm(canon) < SEVERE_HWM:
        return False
    st = canon.get("state")
    if st in ("rejected", "out-of-scope"):
        return False
    if st == "corrected":
        eff = (canon.get("receipts", {}).get("confirmation", {}).get("receipt", {}) or {})
        if _sev_rank(eff.get("effective_severity", eff.get("severity", ""))) <= EFFECTIVE_LOW:
            return False
    return True


def _is_material_downgrade(cand: dict, to: str, receipt: dict, led: dict) -> bool:
    """DERIVED, never caller-selected: a severe (>=HIGH high-water-mark) finding landing at an
    effective-final Low/hardening classification, or extinguished (duplicate/out-of-scope) without a
    VERIFIED preserving canonical link. `rejected` is EXEMPT (its own rejection gate is >= this burden);
    `confirmed` is EXEMPT (oracle-gated positive evidence of the rated impact); `needs-live`/`open`
    keep the finding alive so are NOT downgrades (gpt-5.6-sol threshold)."""
    hwm = _cand_hwm(cand)
    if hwm < SEVERE_HWM:
        return False
    if to in ("rejected", "confirmed", "needs-live-validation", "open"):
        return False
    if to == "corrected":
        eff = _sev_rank(receipt.get("effective_severity", receipt.get("severity", "")))
        return _material_drop(hwm, eff)   # >=2-level drop (Critical->Medium included)
    if to in ("duplicate", "out-of-scope"):
        # extinguishing a severe finding drops it to rank 0 (>=2 levels) unless a canonical preserves it
        return not _canonical_preserves(led, receipt, cand.get("candidate_id", ""))
    return False


def _interpreter_sink(cand: dict) -> bool:
    # coerce every locus to str (a non-string field must not raise) and scan all of them, not just sink.
    # This is a heuristic BACKSTOP — the boundary-scout DANGEROUS-SINK check is the primary classifier;
    # over-match only asks for sink_semantics (mild), under-match is caught upstream.
    s = " ".join(str(cand.get(k, "")) for k in ("sink", "finding_sig", "component", "entry_point")).lower()
    return any(tok in s for tok in INTERPRETER_SINK_RE)


def _validate_interpreter_confirmation(receipt: dict, cand: dict) -> tuple[bool, list]:
    """A confirmation that rates an interpreter/process-sink finding >=2 levels BELOW its severe
    high-water-mark must prove it opened the sink's semantics — otherwise 'confirmed medium' ships
    without the argv/`\\!`/execution-identity analysis that turns F-22 restore into root RCE."""
    hwm = _cand_hwm(cand)
    conf = _sev_rank(receipt.get("effective_severity", receipt.get("severity", "")))
    if not (_interpreter_sink(cand) and _material_drop(hwm, conf)):
        return True, []
    ss = receipt.get("sink_semantics")
    if not isinstance(ss, dict):
        return False, ["confirmation of an interpreter/process sink rated >=2 levels below its "
                       "High/Critical high-water-mark requires sink_semantics {invocation_mode, "
                       "interpreter_grammar, execution_identity} — trace the sink before capping severity"]
    errs = [f"sink_semantics.{k} required" for k in ("invocation_mode", "interpreter_grammar",
            "execution_identity") if not str(ss.get(k, "")).strip()]
    return (not errs), errs


def _validate_material_downgrade(receipt: dict, led: dict, cand: dict) -> tuple[bool, list]:
    """The downgrade bundle: negated hypothesis, consequence/impact-cap trace, a BOUNDED inventory of
    UNIQUE statically-discoverable distinct trigger paths each with PATH-SCOPED evidence (a failed test on
    one path is evidence for THAT path only), gating digests, and a recorded cross-vendor CONCUR_DOWNGRADE
    job BOUND to this candidate (gpt-5.6-sol fixes #2 job-binding, #5 unique-paths/gating-fields)."""
    md = receipt.get("material_downgrade_receipt")
    errs = []
    if not isinstance(md, dict):
        return False, ["material_downgrade_receipt required: this is a High/Critical finding being "
                       "re-rated to Low — a partial rejection that carries the rejection proof burden"]
    if not str(md.get("negated_hypothesis", "")).strip():
        errs.append("material_downgrade_receipt.negated_hypothesis required (the severe claim being negated)")
    if not str(md.get("consequence_trace", "")).strip():
        errs.append("material_downgrade_receipt.consequence_trace required (impact-cap evidence: what the "
                    "sink actually does / why the ceiling is Low)")
    paths = md.get("trigger_paths")
    if not isinstance(paths, list) or not paths:
        errs.append("material_downgrade_receipt.trigger_paths required: inventory EVERY statically-"
                    "discoverable distinct ingress to the sink (unauth/authed/admin/internal/loader)")
    else:
        allowed = {"tested", "static-cleared", "needs-live", "needs-review"}
        seen = set()
        for i, p in enumerate(paths):
            # path_id must be a non-empty STRING — a dict/list id would crash the set (gpt-5.6-sol new-issue)
            if not isinstance(p, dict) or not isinstance(p.get("path_id"), str) or not p["path_id"].strip():
                errs.append(f"trigger_paths[{i}]: path_id required (a non-empty string)"); continue
            pid = p["path_id"].strip()
            if pid in seen:
                errs.append(f"trigger_paths: duplicate path_id {pid!r} (pad-the-inventory guard)")
            seen.add(pid)
            st = p.get("status")
            if st not in allowed:
                errs.append(f"trigger_paths[{pid}]: status must be one of {sorted(allowed)}")
            if st == "tested" and not str(p.get("observed", "")).strip():
                errs.append(f"trigger_paths[{pid}]: tested requires path-scoped `observed`")
            if st in ("static-cleared", "needs-review") and not str(p.get("evidence", "")).strip():
                errs.append(f"trigger_paths[{pid}]: {st} requires `evidence`")
        # a path left needs-live/needs-review is NOT cleared -> the downgrade is not yet earned
        unresolved = [p.get("path_id") for p in paths if isinstance(p, dict)
                      and p.get("status") in ("needs-live", "needs-review")]
        if unresolved:
            errs.append(f"trigger_paths still unresolved (not silently safe): {unresolved} — resolve or "
                        "keep the finding open, do not finalize Low")
    g = md.get("gating")
    if not isinstance(g, dict) or not any(k in GATING_DIGEST_KEYS and str(v).strip()
                                          for k, v in g.items()):
        errs.append(f"material_downgrade_receipt.gating required with a recognised, NON-EMPTY digest "
                    f"field ({sorted(GATING_DIGEST_KEYS)}) binding the evidence to the reviewed code")
    ir = md.get("independent_review")
    if not isinstance(ir, dict) or not str(ir.get("job_id", "")).strip():
        errs.append("material_downgrade_receipt.independent_review.job_id required (an orchestrator-"
                    "dispatched cross-vendor review; the reasoner cannot self-attest it)")
    else:
        job = led.get("cross_vendor_jobs", {}).get(ir["job_id"])
        if job is None:
            errs.append(f"independent_review.job_id {ir['job_id']!r} not a recorded cross-vendor job")
        elif job.get("verdict") != "concur_downgrade":
            errs.append(f"cross-vendor job verdict is {job.get('verdict')!r}; a material downgrade needs "
                        "concur_downgrade — an overturn/inconclusive/uphold does NOT permit it")
        # the job must be BOUND to THIS candidate's immutable id — a concur_downgrade for one finding
        # cannot be reused for another (finding_sig is NOT accepted: it is not unique across components)
        elif cand is not None and job.get("target") != cand.get("candidate_id"):
            errs.append(f"cross-vendor job targets {job.get('target')!r}, not this candidate_id "
                        f"({cand.get('candidate_id')}) — a review cannot be reused across findings")
    return (not errs), errs


def cmd_transition(args) -> int:
    root = _ensure_root(args.ledger, args.target)
    _assert_target_matches(_load(root), args.target)
    to = args.to
    if to not in ALL_STATES:
        raise SystemExit(f"ledger transition: --to must be one of {sorted(ALL_STATES)}; got {to!r}")
    receipt = _read_json_arg(args.receipt, args.file)
    with _Lock(root):
        led = _load(root)
        cand = led["candidates"].get(args.candidate)
        if cand is None:
            raise SystemExit(f"ledger transition: unknown candidate {args.candidate!r} (add it first)")
        bug_class = cand.get("bug_class", "")

        # validate the receipt for the target state
        if to in ("confirmed", "corrected"):
            ok, errs = _validate_confirmation(receipt, bug_class)
            if ok:
                iok, ierrs = _validate_interpreter_confirmation(receipt, cand)
                if not iok:
                    ok, errs = False, ierrs
            kind = "confirmation"
        elif to == "rejected":
            ok, errs = _validate_rejection(receipt, led)
            bok, berrs = _review_job_binds_candidate(receipt, led, cand)
            ok, errs = (ok and bok), errs + berrs
            kind = "rejection"
        elif to == "needs-live-validation":
            ok, errs = _validate_needs_live(receipt)
            kind = "needs_live"
        else:  # duplicate / out-of-scope: lightweight, just needs a reason
            ok = bool(str(receipt.get("reason", "")).strip())
            errs = [] if ok else ["reason required for duplicate/out-of-scope"]
            kind = "note"

        # MATERIAL-DOWNGRADE GATE (derived, label-agnostic): a severe (>=HIGH high-water-mark) finding
        # re-rated to effective-Low via corrected/duplicate/out-of-scope is a PARTIAL REJECTION and
        # carries the rejection proof burden. This is the gate the F-22 restore-RCE downgrade escaped:
        # High->Low recorded as a `corrected` re-rate slid past the reject-only gate.
        if ok and _is_material_downgrade(cand, to, receipt, led):
            mok, merrs = _validate_material_downgrade(receipt, led, cand)
            if not mok:
                ok = False
                errs = ["MATERIAL DOWNGRADE of a High/Critical finding to Low — carries the full "
                        "rejection burden:"] + merrs

        if not ok:
            # REFUSED. Candidate stays where it is. Enqueue the follow-up that closes the gap.
            if to == "rejected":
                _enqueue(led, args.candidate, "incomplete_rejection", "complete_rejection_bundle")
            elif _is_material_downgrade(cand, to, receipt, led):
                _enqueue(led, args.candidate, "incomplete_material_downgrade", "complete_material_downgrade_bundle")
            _atomic_write(root, led)
            out = {"transition": "REFUSED", "candidate_id": args.candidate,
                   "requested_state": to, "current_state": cand["state"], "errors": errs}
            print(json.dumps(out, indent=2))
            return 3

        # ACCEPTED. Record receipt + transition + auto-enqueue PENDING follow-ups.
        rid = _receipt_id(args.candidate, to, receipt)
        certified_commit = _cap(_run_git(Path(args.target), "rev-parse", "HEAD").strip(), 64)
        if not certified_commit and (led.get("target_identity") or {}).get("commit_bindable"):
            raise SystemExit(
                "ledger transition: target is a git worktree but HEAD would not resolve, so this "
                "receipt would be written with an empty certified_commit — unbindable to any tree, "
                "and therefore unable to ever prove it was certified against the audited code. "
                "Fix the worktree before recording the disposition.")
        cand["receipts"][kind] = {"receipt_id": rid, "at": time.strftime(
            "%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now())),
            "certified_commit": certified_commit, "receipt": receipt}
        # a material downgrade that passed the gate records its own receipt so conformance can prove it
        if _is_material_downgrade(cand, to, receipt, led):
            cand["receipts"]["material_downgrade"] = {"receipt_id": rid, "certified_commit": certified_commit,
                "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now())), "receipt": receipt.get("material_downgrade_receipt")}
        cand["state_history"].append({"from": cand["state"], "to": to, "receipt_id": rid,
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))})
        prev = cand["state"]
        cand["state"] = to

        # A bundle-completion action exists because an EARLIER attempt at this transition was
        # refused for an incomplete receipt. Landing the transition with a receipt that passes the
        # full gate IS the completion — reconcile it here rather than making the operator close the
        # same work twice. Unreconciled duplicates were pure ceremony, and ceremony is what drives
        # operators to bypass the ledger entirely (gpt-5.6-sol adoption-friction review).
        reconciled = []
        _RECONCILE = {"rejected": "complete_rejection_bundle"}
        for a in led["pending_actions"]:
            if a.get("state") == "completed" or a.get("target") != args.candidate:
                continue
            req = a.get("required_action")
            if req == _RECONCILE.get(to) or (
                    req == "complete_material_downgrade_bundle" and "material_downgrade" in cand["receipts"]):
                a["state"] = "completed"
                a["completion_receipt"] = {"receipt_id": rid, "receipt": {"reconciled_by_transition": to},
                    "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))}
                reconciled.append(a["action_id"])

        enqueued = []
        if to in ("confirmed", "corrected"):
            if (bug_class or "").lower() in DIRTY_BUG_CLASSES or receipt.get("dirty") is True:
                a = _enqueue(led, args.candidate, "memory_bug_confirmed", "dirty_sweep")
                enqueued.append(a["action_id"])
        elif to == "needs-live-validation":
            a = _enqueue(led, args.candidate, "server_dependency", "live_validation")
            enqueued.append(a["action_id"])

        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"transition": "ACCEPTED", "candidate_id": args.candidate,
                      "from": prev, "to": to, "receipt_id": rid,
                      "pending_enqueued": enqueued,
                      "pending_reconciled": reconciled}, indent=2))
    return 0


def _validate_enumerate_trigger_paths(receipt: dict, led: dict, cand: dict) -> tuple[bool, list]:
    # the discovered paths must MECHANICALLY include the sink's callers/routes/dispatchers/loaders
    # (gpt-5.6-sol review, missing #1: fixes the mis-scoped re-sweep that silently omits files).
    errs = []
    if not str(receipt.get("enumeration_recipe", "")).strip():
        errs.append("enumeration_recipe required (the route/reference/dispatcher/loader searches "
                    "run to establish the path set — not a manually chosen file list)")
    paths = receipt.get("trigger_paths")
    if not isinstance(paths, list) or not paths:
        errs.append("trigger_paths required: every statically-discoverable distinct ingress to "
                    "the sink, each with a status (tested/static-cleared/needs-live/needs-review)")
    return (not errs, errs)


def _validate_live_validation(receipt: dict, led: dict, cand: dict) -> tuple[bool, list]:
    """A server-dependent finding's live test. This previously closed on `{}` — the widest
    fail-open in the gate, and enough on its own to walk a run's verdict from FAIL to PASS with no
    evidence at all. A live validation that resolves nothing does not close the action; it must
    say what it OBSERVED and which way the predicate went."""
    errs = []
    outcome = receipt.get("outcome")
    if outcome not in LIVE_OUTCOMES:
        errs.append(f"outcome required, one of {sorted(LIVE_OUTCOMES)} — a live validation exists to "
                    "RESOLVE the unknown; closing it without a verdict re-buries it")
    if not str(receipt.get("observation", "")).strip():
        errs.append("observation required (what the test actually showed, not what you expected)")
    arts = receipt.get("artifacts")
    if not isinstance(arts, list) or not [a for a in arts if str(a).strip()]:
        errs.append("artifacts required: the log/capture/response the observation was read from")
    if not str(receipt.get("build_digest", "")).strip():
        errs.append("build_digest required (WHAT you tested against — an image digest/commit; a "
                    "result against an unrecorded build cannot be tied back to the reviewed tree)")
    if outcome == "inconclusive" and not str(receipt.get("blocker", "")).strip():
        errs.append("outcome=inconclusive requires `blocker` (what prevented resolution) — and the "
                    "candidate stays needs-live-validation, which the closure gate will block on")
    return (not errs, errs)


def _validate_rejection_bundle(receipt: dict, led: dict, cand: dict) -> tuple[bool, list]:
    ok, errs = _validate_rejection(receipt, led)
    if cand is not None:
        ok2, errs2 = _review_job_binds_candidate(receipt, led, cand)
        ok, errs = (ok and ok2), errs + errs2
    return (ok, errs)


def _validate_material_downgrade_bundle(receipt: dict, led: dict, cand: dict) -> tuple[bool, list]:
    if cand is None:
        return (False, ["material-downgrade bundle needs a resolvable target candidate"])
    return _validate_material_downgrade({"material_downgrade_receipt": receipt}, led, cand)


# Default-deny: every required_action MUST map to a validator. An action type with no validator is
# REFUSED, not waved through — the old code validated two of five and let the rest close on `{}`.
PENDING_VALIDATORS = {
    "dirty_sweep": lambda r, l, c: _validate_dirty_sweep(r),
    "enumerate_trigger_paths": _validate_enumerate_trigger_paths,
    "live_validation": _validate_live_validation,
    "complete_rejection_bundle": _validate_rejection_bundle,
    "complete_material_downgrade_bundle": _validate_material_downgrade_bundle,
}


def cmd_pending_complete(args) -> int:
    root = _ensure_root(args.ledger, None)
    receipt = _read_json_arg(args.receipt, args.file) if (args.receipt or args.file) else {}
    with _Lock(root):
        led = _load(root)
        action = next((a for a in led["pending_actions"] if a.get("action_id") == args.action), None)
        if action is None:
            raise SystemExit(f"ledger pending-complete: unknown action {args.action!r}")
        # completion is IMMUTABLE — re-completing would let a valid receipt be overwritten by a
        # weaker one after the fact (gpt-5.6-sol review of this change).
        if action.get("state") == "completed":
            print(json.dumps({"pending_complete": "REFUSED", "action_id": args.action,
                              "errors": ["action already completed; completion receipts are immutable"]},
                             indent=2))
            return 3
        req = action.get("required_action")
        validator = PENDING_VALIDATORS.get(req)
        if validator is None:
            print(json.dumps({"pending_complete": "REFUSED", "action_id": args.action,
                              "errors": [f"no validator registered for required_action {req!r}; "
                                         "an unvalidated action type cannot be closed (default-deny)"]},
                             indent=2))
            return 3
        cand = led["candidates"].get(action.get("target"))
        ok, errs = validator(receipt, led, cand)
        if not ok:
            print(json.dumps({"pending_complete": "REFUSED", "action_id": args.action,
                              "errors": errs}, indent=2))
            return 3
        rid = _receipt_id(action["target"], "pending:" + action["required_action"], receipt)
        action["state"] = "completed"
        action["completion_receipt"] = {"receipt_id": rid, "receipt": receipt,
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))}
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"pending_complete": "OK", "action_id": args.action, "receipt_id": rid}))
    return 0


def _open_sweeps_for_file(led: dict, file_path: str) -> list:
    """Actions blocking closure of file_path: a queued dirty_sweep whose target candidate's
    path is under (or equal to) file_path."""
    blocking = []
    for a in led["pending_actions"]:
        if a.get("required_action") != "dirty_sweep" or a.get("state") == "completed":
            continue
        cand = led["candidates"].get(a.get("target", ""), {})
        cpath = cand.get("path", "")
        if cpath == file_path or cpath.startswith(file_path.rstrip("/") + "/") \
                or file_path == cand.get("path", ""):
            blocking.append(a["action_id"])
    return blocking


def cmd_file_close(args) -> int:
    root = _ensure_root(args.ledger, None)
    with _Lock(root):
        led = _load(root)
        blocking = _open_sweeps_for_file(led, args.file)
        if blocking:
            print(json.dumps({"file_close": "REFUSED", "file": args.file,
                "open_sweep_actions": blocking,
                "reason": "a proven-dirty file cannot close while its DIRTY_SWEEP is open"}, indent=2))
            return 3
        if args.file not in led["closed_files"]:
            led["closed_files"].append(_cap(args.file, 256))
        led["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now()))
        _atomic_write(root, led)
    print(json.dumps({"file_close": "OK", "file": args.file}))
    return 0


def cmd_summary(args) -> int:
    root = assert_safe_ledger_root(Path(args.ledger), None)
    led = _load(root)
    refs, counts = [], {}
    for cid, c in sorted(led["candidates"].items()):
        st = c.get("state", "open")
        counts[st] = counts.get(st, 0) + 1
        rec_ids = {k: v.get("receipt_id") for k, v in c.get("receipts", {}).items()}
        refs.append({"candidate_id": cid, "state": st, "component": c.get("component", ""),
                     "path": c.get("path", ""), "receipts": rec_ids,
                     "one_line": f"{cid} {st}" + (f" [{','.join(rec_ids.values())}]" if rec_ids else "")})
    open_pending = [a for a in led["pending_actions"] if a.get("state") != "completed"]
    delivery = _delivery_assessment(led)
    payload = {"candidate_count": len(led["candidates"]), "state_counts": counts,
               "open_pending_actions": open_pending, "cross_vendor_jobs": len(led["cross_vendor_jobs"]),
               "closed_files": led["closed_files"], "candidates": refs,
               "report_blocking": bool(open_pending),
               "intervention_count": len(led["interventions"]),
               "handoff_review_count": len(led["handoff_reviews"]),
               **delivery}
    print(json.dumps(payload, indent=2))
    return 0


def _read_component_lines(path: str) -> list:
    """Read a newline-delimited component/id list, fail-closed like the KB helper's
    inventory reader (invalid UTF-8 / oversize / traversal entry -> hard refusal)."""
    p = Path(path)
    if p.stat().st_size > MAX_INPUT_BYTES:
        raise SystemExit(f"ledger: list {path} exceeds {MAX_INPUT_BYTES} bytes; refusing (fail-closed)")
    out = []
    for raw in p.read_bytes().splitlines():
        try:
            c = raw.decode("utf-8").strip()
        except UnicodeDecodeError:
            raise SystemExit(f"ledger: list {path} has invalid UTF-8; refusing (fail-closed)")
        if not c or c.startswith("#"):
            continue
        out.append(c)
    return out


def _candidate_by_ref(led: dict, ref: str):
    """Resolve a claim reference (candidate_id OR finding_sig) to a candidate."""
    if ref in led["candidates"]:
        return led["candidates"][ref]
    for c in led["candidates"].values():
        if c.get("finding_sig") == ref:
            return c
    return None


def cmd_conformance(args) -> int:
    """The deterministic closure gate: treat the finished run as a set of claims, each of
    which must resolve to a ledger fact or a receipt. Machine set-difference, NOT a model
    self-audit.

    FAIL-CLOSED. A check whose inputs were not supplied does NOT silently pass: it lands in
    `checks_skipped` with a reason and caps the verdict at PARTIAL. `checks_executed` is built from
    the branches that actually ran — it was previously a hardcoded six-element list printed
    regardless, so a bare invocation attested to three checks it never performed.

    Verdicts: PASS (all checks ran, all diffs empty) / PARTIAL (nothing contradicted, but a
    mandatory check was skipped) / FAIL (a check found a contradiction). Only PASS exits 0.
    A known failure stays FAIL — there is no flag that renames it to something softer."""
    root = assert_safe_ledger_root(Path(args.ledger), None)
    led = _load(root)
    failures = {}   # check -> list of offending items
    executed, skipped = [], []

    def fail(check, items):
        if items:
            failures[check] = items

    def skip(check, why):
        skipped.append({"check": check, "reason": why})

    # (1) coverage completeness: every inventory component covered or explicitly omitted.
    if args.inventory:
        inv = set(_read_component_lines(args.inventory))
        covered = set(_read_component_lines(args.covered)) if args.covered else set()
        omitted = set(_read_component_lines(args.omitted)) if args.omitted else set()
        # an empty denominator makes every set-difference vacuously empty — a coverage claim over
        # nothing is not a coverage claim (gpt-5.6-sol review of this change).
        if not inv:
            fail("coverage_inventory_empty",
                 ["--inventory resolved to zero components; an empty denominator makes the coverage "
                  "diff vacuously empty and would report full coverage of nothing"])
        fail("uncovered_components_implied_done", sorted(inv - covered - omitted))
        # a component claimed covered that isn't in the inventory is a bookkeeping error
        fail("covered_not_in_inventory", sorted(covered - inv))
        executed.append("coverage")
    else:
        skip("coverage", "--inventory not supplied — component coverage was NOT verified; this is "
                         "the axis that proves no module was silently skipped")

    # (0) the ledger was actually used. A run with no candidates and no target identity is not a
    # clean hunt, it is a hunt that never recorded anything — the observed real-world failure is an
    # engagement whose ledger/ directory was simply left empty while the report read as finished.
    # Vacuous set-differences must never certify that.
    if not led["candidates"]:
        fail("empty_ledger_no_hunt_recorded",
             ["the ledger holds zero candidates; a run that recorded no candidate cannot be "
              "certified closed — every check below is vacuously satisfied by absence"])
    if not (led.get("target_identity") or {}).get("target_path_id"):
        fail("ledger_never_initialised",
             ["no target_identity — run `init --target <dir>` so receipts bind to a known tree"])
    executed.append("ledger_used")

    # (2) ledger integrity: a terminal state MUST carry its receipt (guards direct edits
    # that bypass the transition gate).
    missing_receipt, unswept, bad_state, stale_receipt_content = [], [], [], []
    for cid, c in led["candidates"].items():
        st = c.get("state")
        rcpts = c.get("receipts", {})
        # an unknown state evades every terminal/open test below — a direct edit to "reviewed" or
        # "done" would otherwise sail through (gpt-5.6-sol review of this change).
        if st not in ALL_STATES:
            bad_state.append(f"{cid}:unknown-state:{st!r}")
        if st in ("confirmed", "corrected") and "confirmation" not in rcpts:
            missing_receipt.append(f"{cid}:{st}:no-confirmation-receipt")
        if st == "rejected" and "rejection" not in rcpts:
            missing_receipt.append(f"{cid}:{st}:no-rejection-receipt")
        # RE-VALIDATE the stored receipt, don't just check the key exists. Presence-only checking is
        # what let a direct edit — or a receipt written under an older, weaker contract — keep a
        # terminal state it could no longer earn today (gpt-5.6-sol: "missing blocker #1").
        if st == "rejected" and "rejection" in rcpts:
            stored = (rcpts.get("rejection") or {}).get("receipt") or {}
            rok, rerrs = _validate_rejection(stored, led)
            bok, berrs = _review_job_binds_candidate(stored, led, c)
            if not (rok and bok):
                stale_receipt_content.append(f"{cid}:rejection-receipt-invalid:{'; '.join(rerrs + berrs)[:220]}")
        # a confirmed proven-dirty file needs a completed sweep OR an open pending (never silently none)
        if st in ("confirmed", "corrected") and (c.get("bug_class", "").lower() in DIRTY_BUG_CLASSES):
            aid = _action_id(cid, "dirty_sweep")
            act = next((a for a in led["pending_actions"] if a.get("action_id") == aid), None)
            if act is None:
                unswept.append(f"{cid}:dirty-class-confirmed-with-no-sweep-action")
    fail("terminal_state_missing_receipt", missing_receipt)
    fail("dirty_confirmed_without_sweep", unswept)
    fail("candidate_in_unknown_state", bad_state)
    fail("stored_receipt_fails_current_contract", stale_receipt_content)
    executed.append("ledger_integrity")

    # (2b) NON-TERMINAL candidates block closure. SKILL.md promises the diff "candidate ledger −
    # candidates with a terminal or explicitly-pending disposition"; it was never implemented, so a
    # candidate sitting at `open` or `needs-live-validation` was invisible to the gate and the run
    # could report as closed with unfinished candidates in it. needs-live-validation counts: it is a
    # first-class outcome DURING the hunt, but an unresolved one at closure is exactly the
    # "dropped pending/inconclusive" fraud class.
    nonterminal = sorted(f"{cid}:{c.get('state')}" for cid, c in led["candidates"].items()
                         if c.get("state") in STATES_OPEN)
    fail("nonterminal_candidates_block_closure", nonterminal)
    executed.append("candidate_closure")

    # (3) open pendings block the report.
    open_pending = [f"{a['action_id']}:{a['required_action']}->{a['target']}"
                    for a in led["pending_actions"] if a.get("state") != "completed"]
    fail("open_pending_actions_block_report", open_pending)
    executed.append("pending")

    # (3a) review-provenance hygiene: a job with no bound evidence or no named vendor cannot
    # substantiate the kill/downgrade that cites it. Legacy jobs (written before these fields were
    # required) surface here rather than silently counting as independent review.
    unbound_jobs = sorted(
        f"{jid}:{'no-evidence_hash' if not str(j.get('evidence_hash','')).strip() else 'no-vendor'}"
        for jid, j in led.get("cross_vendor_jobs", {}).items()
        if not str(j.get("evidence_hash", "")).strip() or not str(j.get("vendor", "")).strip())
    fail("unauthenticated_review_jobs", unbound_jobs)
    executed.append("review_provenance")

    # (3b) material-downgrade laundering: a severe (>=HIGH high-water-mark) finding that landed at an
    # effective-Low TERMINAL state must carry a material_downgrade receipt. Catches a High->Low re-rate
    # slipped in by a direct edit that bypassed the transition gate, incl. stair-step (High->Med->Low)
    # and alias dispositions (corrected/duplicate/out-of-scope). An OPEN needs-live High is fine (alive).
    laundered = []
    for cid, c in led["candidates"].items():
        if _cand_hwm(c) < SEVERE_HWM:   # defensive: max(hwm, created potential) — direct-edit resistant
            continue
        st = c.get("state")
        rcpts = c.get("receipts", {})
        landed_low = False
        if st == "corrected":
            eff = (rcpts.get("confirmation", {}).get("receipt", {}) or {})
            landed_low = _material_drop(_cand_hwm(c), _sev_rank(eff.get("effective_severity", eff.get("severity", ""))))
        elif st in ("duplicate", "out-of-scope"):
            note = (rcpts.get("note", {}).get("receipt", {}) or {})
            landed_low = not _canonical_preserves(led, note, cid)
        if not landed_low:
            continue
        # re-run FULL validation on the stored receipt — an empty/fake material_downgrade key must not
        # defeat the check (gpt-5.6-sol fix #3). Reconstruct the wrapper the validator expects.
        stored = (rcpts.get("material_downgrade", {}) or {}).get("receipt")
        mok, _ = _validate_material_downgrade({"material_downgrade_receipt": stored}, led, c) if stored else (False, [])
        if not mok:
            laundered.append(f"{cid}:hwm={c.get('potential_hwm') or c.get('potential_severity')}->{st}"
                             f":effective-Low:no-valid-material-downgrade-receipt")
    fail("severe_finding_downgraded_to_low_without_receipt", laundered)
    executed.append("material_downgrade_laundering")

    # (4) staleness: a receipt certified against a different commit than the current tree.
    if args.target:
        # the ledger must be the one initialised for THIS target — otherwise conformance can be
        # pointed at a convenient second repo whose HEAD happens to match.
        want_id = (led.get("target_identity") or {}).get("target_path_id", "")
        got_id = (compute_identity(Path(args.target)) or {}).get("target_path_id", "")
        if want_id and got_id and want_id != got_id:
            fail("target_mismatch", [f"--target resolves to {got_id} but this ledger was initialised "
                                     f"for {want_id}; refusing to certify one tree against another"])
        cur = _run_git(Path(args.target), "rev-parse", "HEAD").strip()
        if not cur and not (Path(args.target) / ".git").exists():
            # a legitimately non-VCS target (source drop, tarball) cannot be commit-bound. That is
            # not a contradiction, but it IS reduced assurance — so it caps at PARTIAL rather than
            # silently passing, which is what the old code did.
            skip("staleness", "--target is not a git worktree; receipts cannot be commit-bound, so "
                              "staleness could not be established")
        elif not cur:
            # a git target whose HEAD will not resolve is a real problem, not an absent feature.
            fail("target_commit_unresolvable",
                 ["--target has a .git but rev-parse HEAD produced nothing; receipt staleness "
                  "cannot be established, so no receipt can be certified against the current tree"])
            executed.append("staleness")
        else:
            stale, unbound = [], []
            for cid, c in led["candidates"].items():
                for kind, r in c.get("receipts", {}).items():
                    cc = r.get("certified_commit", "")
                    if not cc:
                        # an unbound receipt is not "fresh", it is unverifiable — it was previously
                        # skipped, which made every legacy receipt permanently un-stale.
                        unbound.append(f"{cid}:{kind}:no-certified_commit")
                    elif cc != cur:
                        stale.append(f"{cid}:{kind}:certified@{cc[:10]}!=head@{cur[:10]}")
            fail("stale_receipts_vs_current_commit", stale)
            fail("receipts_not_bound_to_a_commit", unbound)
            executed.append("staleness")
    else:
        skip("staleness", "--target not supplied — receipt-vs-tree staleness was NOT verified; a "
                          "PoC that reproduced against a different build would go undetected")

    # (5) claims manifest reconciliation: each claim resolves to a ledger fact.
    if args.claims:
        claims = _read_json_arg(None, args.claims)
        want = {"confirmed": ("confirmed", "corrected"), "rejected": ("rejected",),
                "needs_live": ("needs-live-validation",)}
        bad = []
        for key, states in want.items():
            for ref in claims.get(key, []):
                c = _candidate_by_ref(led, ref)
                if c is None:
                    bad.append(f"claim {key}:{ref} -> no such candidate in ledger")
                elif c.get("state") not in states:
                    bad.append(f"claim {key}:{ref} -> ledger says state={c.get('state')!r}")
        fail("report_claims_contradict_ledger", bad)
        executed.append("claims")
    else:
        skip("claims", "--claims not supplied — the report's own assertions were NOT reconciled "
                       "against the ledger; this is the axis that catches a report claiming a "
                       "disposition the state machine never recorded")

    # (6) owner-delivery extension. This is opt-in because it is deliberately orthogonal to the
    # technical verdict: an evidence-backed finding may be technically final while its PoC package
    # still needs documentation or environment repair. Owner-facing delivery runs opt in with
    # --require-handoff; the gate then demands a fresh, uncoached operator replay.
    delivery = _delivery_assessment(led)
    if args.require_handoff:
        if delivery["delivery_readiness"] != "ready":
            fail("delivery_readiness_not_ready",
                 [delivery["delivery_readiness"] + ": " + reason
                  for reason in delivery["blocking_reasons"]])
        latest = led.get("handoff_reviews", [])[-1] if led.get("handoff_reviews") else None
        if not args.target:
            fail("handoff_staleness_unchecked",
                 ["--require-handoff also requires --target so the cold-handoff receipt can be "
                  "bound to the current audited commit"])
        elif latest is not None:
            cur = _run_git(Path(args.target), "rev-parse", "HEAD").strip()
            certified = latest.get("certified_commit", "")
            commit_bindable = bool((led.get("target_identity") or {}).get("commit_bindable"))
            if commit_bindable and not certified:
                fail("handoff_receipt_not_commit_bound",
                     [f"{latest.get('review_id')}: no certified_commit"])
            elif cur and certified != cur:
                fail("stale_handoff_receipt_vs_current_commit",
                     [f"{latest.get('review_id')}: certified@{certified[:10]}!=head@{cur[:10]}"])
        executed.append("fresh_operator_handoff")

    # VERDICT. Three values, derived from facts — never a caller-chosen label, and there is no
    # "PASS with residue". A known contradiction is FAIL even on an interim run; skipped mandatory
    # inputs are PARTIAL (nothing contradicted, but nothing like full assurance either).
    if failures:
        verdict = "FAIL"
    elif skipped:
        verdict = "PARTIAL"
    else:
        verdict = "PASS"
    print(json.dumps({"conformance": verdict,
                      "checks_executed": sorted(set(executed)),
                      "checks_skipped": skipped,
                      "failures": failures,
                      "delivery": delivery}, indent=2))
    return 0 if verdict == "PASS" else 3


# ================================ main =========================================

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="raptor-loop-ledger", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init"); p.add_argument("--ledger", required=True)
    p.add_argument("--target", required=True); p.set_defaults(func=cmd_init)

    p = sub.add_parser("add"); p.add_argument("--ledger", required=True)
    p.add_argument("--target", required=True)
    p.add_argument("--record"); p.add_argument("--file")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("cross-vendor"); p.add_argument("--ledger", required=True)
    p.add_argument("--job"); p.add_argument("--file")
    p.set_defaults(func=cmd_cross_vendor)

    p = sub.add_parser("intervention"); p.add_argument("--ledger", required=True)
    p.add_argument("--target", required=True); p.add_argument("--record"); p.add_argument("--file")
    p.set_defaults(func=cmd_intervention)

    p = sub.add_parser("intervention-resolve"); p.add_argument("--ledger", required=True)
    p.add_argument("--target", required=True); p.add_argument("--intervention", required=True)
    p.add_argument("--record"); p.add_argument("--file")
    p.set_defaults(func=cmd_intervention_resolve)

    p = sub.add_parser("handoff-review"); p.add_argument("--ledger", required=True)
    p.add_argument("--target", required=True); p.add_argument("--record"); p.add_argument("--file")
    p.set_defaults(func=cmd_handoff_review)

    p = sub.add_parser("transition"); p.add_argument("--ledger", required=True)
    p.add_argument("--target", required=True); p.add_argument("--candidate", required=True)
    p.add_argument("--to", required=True); p.add_argument("--receipt"); p.add_argument("--file")
    p.set_defaults(func=cmd_transition)

    p = sub.add_parser("pending-complete"); p.add_argument("--ledger", required=True)
    p.add_argument("--action", required=True); p.add_argument("--receipt"); p.add_argument("--file")
    p.set_defaults(func=cmd_pending_complete)

    p = sub.add_parser("file-close"); p.add_argument("--ledger", required=True)
    p.add_argument("--file", required=True); p.set_defaults(func=cmd_file_close)

    p = sub.add_parser("summary"); p.add_argument("--ledger", required=True)
    p.set_defaults(func=cmd_summary)

    p = sub.add_parser("conformance"); p.add_argument("--ledger", required=True)
    p.add_argument("--target"); p.add_argument("--inventory"); p.add_argument("--covered")
    p.add_argument("--omitted"); p.add_argument("--claims"); p.add_argument("--require-handoff", action="store_true")
    p.set_defaults(func=cmd_conformance)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
